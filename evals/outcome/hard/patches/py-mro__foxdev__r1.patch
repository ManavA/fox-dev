@@ -0,0 +1,190 @@
+//! Python method resolution for `fox code X --rel callers`: where `self.m()`, `cls.m()` and
+//! `super().m()` go, by the C3 linearization of the class the call sits in, over the base
+//! classes the index resolved. A class whose bases are not all known is left to name
+//! resolution when the walk reaches an unknown one before a definition.
+
+use crate::tsindex::{is_callable_kind, is_type_kind};
+use anyhow::Result;
+use rusqlite::{Connection, params};
+use std::collections::{HashMap, VecDeque};
+
+/// One class of a linearization: a project class, or a base the index could not resolve (by name).
+#[derive(Clone, PartialEq, Eq, Hash, Debug)]
+enum Entry {
+    Known(i64),
+    Unknown(String),
+}
+
+/// Deepest chain of base classes read.
+const DEPTH: usize = 24;
+
+struct Mro<'a> {
+    c: &'a Connection,
+    name: &'a str,
+    pid: i64,
+    memo: HashMap<i64, Option<Vec<Entry>>>,
+    members: HashMap<i64, Vec<i64>>,
+    class_of: HashMap<i64, Option<i64>>,
+}
+
+impl Mro<'_> {
+    fn bases(&self, class: i64) -> Result<Vec<Entry>> {
+        let mut q = self.c.prepare_cached("SELECT dst, name, amb FROM ts_ref WHERE src = ?1 AND kind = 'impl' ORDER BY rowid")?;
+        let rows: Vec<(i64, String, i64)> = q.query_map([class], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)))?.flatten().collect();
+        let mut out: Vec<Entry> = vec![];
+        for (dst, name, amb) in rows {
+            let known = dst != 0 && amb <= 0 && dst != class && self.kind_of(dst).is_some_and(|k| is_type_kind(&k));
+            let e = if known { Entry::Known(dst) } else { Entry::Unknown(name) };
+            if !out.contains(&e) {
+                out.push(e);
+            }
+        }
+        Ok(out)
+    }
+
+    fn kind_of(&self, id: i64) -> Option<String> {
+        self.c
+            .query_row("SELECT json_extract(meta,'$.k') FROM node WHERE id = ?1 AND kind = 'symbol'", [id], |r| {
+                r.get::<_, Option<String>>(0)
+            })
+            .ok()
+            .flatten()
+    }
+
+    /// The C3 linearization of `class`, or None when the hierarchy is inconsistent or too deep.
+    fn mro(&mut self, class: i64, stack: &mut Vec<i64>) -> Result<Option<Vec<Entry>>> {
+        if let Some(m) = self.memo.get(&class) {
+            return Ok(m.clone());
+        }
+        if stack.contains(&class) || stack.len() >= DEPTH {
+            return Ok(None);
+        }
+        stack.push(class);
+        let bases = self.bases(class)?;
+        let mut seqs: Vec<VecDeque<Entry>> = vec![];
+        let mut ok = true;
+        for b in &bases {
+            match b {
+                Entry::Known(k) => match self.mro(*k, stack)? {
+                    Some(m) => seqs.push(m.into()),
+                    None => ok = false,
+                },
+                Entry::Unknown(_) => seqs.push(VecDeque::from([b.clone()])),
+            }
+        }
+        stack.pop();
+        let result = if ok {
+            seqs.push(bases.into());
+            merge(Entry::Known(class), seqs)
+        } else {
+            None
+        };
+        self.memo.insert(class, result.clone());
+        Ok(result)
+    }
+
+    /// Ids of the members of `class` named like the method.
+    fn defined(&mut self, class: i64) -> Result<&Vec<i64>> {
+        if !self.members.contains_key(&class) {
+            let mut q = self.c.prepare_cached(
+                "SELECT id FROM node WHERE project_id = ?1 AND kind = 'symbol' AND name = ?2 AND source = 'treesitter'
+                   AND json_extract(meta,'$.pid') = ?3",
+            )?;
+            let v: Vec<i64> = q.query_map(params![self.pid, self.name, class], |r| r.get(0))?.flatten().collect();
+            self.members.insert(class, v);
+        }
+        Ok(&self.members[&class])
+    }
+
+    /// The class whose method a call in definition `src` goes through `self`: the nearest
+    /// enclosing class (a nested function sees its method's `self`).
+    fn class_of(&mut self, src: i64) -> Option<i64> {
+        if let Some(c) = self.class_of.get(&src) {
+            return *c;
+        }
+        let mut cur = src;
+        let mut found = None;
+        for _ in 0..8 {
+            let up: i64 = self
+                .c
+                .query_row("SELECT COALESCE(json_extract(meta,'$.pid'), 0) FROM node WHERE id = ?1", [cur], |r| r.get(0))
+                .unwrap_or(0);
+            let Some(k) = (up != 0).then(|| self.kind_of(up)).flatten() else { break };
+            if is_type_kind(&k) {
+                found = Some(up);
+                break;
+            }
+            if !is_callable_kind(&k) {
+                break;
+            }
+            cur = up;
+        }
+        self.class_of.insert(src, found);
+        found
+    }
+}
+
+/// C3 merge of `seqs` (each class's linearization, then the list of bases) behind `head`.
+fn merge(head: Entry, mut seqs: Vec<VecDeque<Entry>>) -> Option<Vec<Entry>> {
+    let mut out = vec![head];
+    loop {
+        seqs.retain(|s| !s.is_empty());
+        if seqs.is_empty() {
+            return Some(out);
+        }
+        let pick = seqs.iter().map(|s| &s[0]).find(|h| !seqs.iter().any(|s| s.iter().skip(1).any(|x| x == *h)))?.clone();
+        for s in seqs.iter_mut() {
+            if s.front() == Some(&pick) {
+                s.pop_front();
+            }
+        }
+        out.push(pick);
+    }
+}
+
+/// For `top`, a Python method, the calls named like it through `self`, `cls` or `super()` whose
+/// target the method resolution order decides: call rowid -> whether it reaches `top`. A call
+/// whose walk meets a base the index does not know before any definition is not in the map.
+/// Empty for anything but a Python method.
+pub fn decided_calls(c: &Connection, pid: i64, top_id: i64, top_name: &str, top_path: &str, top_kind: &str) -> Result<HashMap<i64, bool>> {
+    let mut out = HashMap::new();
+    let py = |p: &str| crate::lang::for_path(p).is_some_and(|l| l.family == "python");
+    if !py(top_path) || !is_callable_kind(top_kind) {
+        return Ok(out);
+    }
+    let in_class: bool = c
+        .query_row(
+            "SELECT json_extract(meta,'$.pid') IS NOT NULL AND json_extract(meta,'$.pid') != 0 FROM node WHERE id = ?1",
+            [top_id],
+            |r| r.get(0),
+        )
+        .unwrap_or(false);
+    if !in_class {
+        return Ok(out);
+    }
+    // Precise (SCIP) targets, `amb < 0`, are not second-guessed.
+    let mut q = c.prepare_cached(
+        "SELECT rowid, path, src, via FROM ts_ref WHERE project_id = ?1 AND name = ?2 AND kind = 'call' AND recv != 0 AND amb >= 0
+           AND via IN ('self', 'cls', 'super') AND src != 0",
+    )?;
+    let rows: Vec<(i64, String, i64, String)> =
+        q.query_map(params![pid, top_name], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)))?.flatten().collect();
+    let mut m = Mro { c, name: top_name, pid, memo: HashMap::new(), members: HashMap::new(), class_of: HashMap::new() };
+    for (rowid, path, src, via) in rows {
+        if !py(&path) {
+            continue;
+        }
+        let Some(class) = m.class_of(src) else { continue };
+        let Some(lin) = m.mro(class, &mut vec![])? else { continue };
+        let skip = usize::from(via == "super");
+        for e in lin.iter().skip(skip) {
+            let Entry::Known(k) = e else { break };
+            let defs = m.defined(*k)?;
+            if !defs.is_empty() {
+                out.insert(rowid, defs.contains(&top_id));
+                break;
+            }
+        }
+    }
+    Ok(out)
+}
