+
+/// Python: `self.m()` and `super().m()` go where the method resolution order (C3) of the class
+/// they sit in says: a mixin ahead of the base, the other arm of a diamond, a subclass's own
+/// override; a call in a class that overrides nothing still reaches the base.
+#[test]
+fn python_callers_follow_the_method_resolution_order() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("pkg/__init__.py", ""),
+        (
+            "pkg/base.py",
+            "class Base:\n    def step(self):\n        return 1\n\n    def run_base(self):\n        return self.step()\n\n\nclass Mixin:\n    def step(self):\n        return 2\n\n\nclass Top:\n    def hook(self):\n        return 0\n\n\nclass Right(Top):\n    def hook(self):\n        return 1\n\n\nclass Left(Top):\n    pass\n",
+        ),
+        (
+            "pkg/child.py",
+            "from pkg.base import Base, Mixin, Left, Right\n\n\nclass Child(Mixin, Base):\n    def go(self):\n        return self.step()\n\n    def up(self):\n        return super().step()\n\n\nclass Quiet(Base):\n    def quiet_go(self):\n        return self.step()\n\n\nclass Loud(Base):\n    def step(self):\n        return super().step() + 1\n\n    def loud_go(self):\n        return self.step()\n\n\nclass Diamond(Left, Right):\n    def dia_go(self):\n        return self.hook()\n\n    def dia_up(self):\n        return super().hook()\n\n\nclass Plain(Left):\n    def plain_go(self):\n        return self.hook()\n",
+        ),
+    ]);
+    let callers = |sym: &str| resolved(&fox_code(&p, sym, "callers", 2000));
+    let has = |out: &str, who: &[&str], not: &[&str]| {
+        for w in who {
+            assert!(out.contains(&format!("{w} c:")), "{w} missing: {out}");
+        }
+        for w in not {
+            assert!(!out.contains(&format!("{w} c:")), "{w} listed: {out}");
+        }
+    };
+    has(&callers("Base.step"), &["Base.run_base", "Quiet.quiet_go", "Loud.step"], &["Child.go", "Child.up", "Loud.loud_go"]);
+    has(&callers("Mixin.step"), &["Child.go", "Child.up"], &["Base.run_base", "Quiet.quiet_go", "Loud.step", "Loud.loud_go"]);
+    has(&callers("Loud.step"), &["Loud.loud_go"], &["Child.go", "Quiet.quiet_go"]);
+    has(&callers("Right.hook"), &["Diamond.dia_go", "Diamond.dia_up"], &["Plain.plain_go"]);
+    has(&callers("Top.hook"), &["Plain.plain_go"], &["Diamond.dia_go", "Diamond.dia_up"]);
+    // Followed through an import, the MRO sites are certain, not guesses.
+    assert!(!callers("Mixin.step").contains("guess"), "{}", callers("Mixin.step"));
+    // A base the index does not know ahead of the definition leaves the call to name resolution.
+    let (_h, _r, p) = inline_project(&[
+        ("a.py", "class Base:\n    def step(self):\n        return 1\n"),
+        (
+            "b.py",
+            "from external import External\nfrom a import Base\n\n\nclass Ext(External, Base):\n    def go(self):\n        return self.step()\n",
+        ),
+    ]);
+    let out = resolved(&fox_code(&p, "Base.step", "callers", 2000));
+    assert!(out.contains("Ext.go c:"), "{out}");
+}
