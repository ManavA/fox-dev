+/// C: make the members typed by a typedef (`op_fn run;`) function-pointer members when the
+/// typedef, through typedefs of typedefs and in any file, names a function pointer (or, for a
+/// member behind a `*`, a function type), and plain fields again when it no longer does. Every
+/// such member of the project, or those of `paths`: a file stored just now has its members
+/// typed only by the typedefs of its own file. Marked `fr`, so the type facts of the file still
+/// read as the plain field the file parses to.
+fn c_reclassify_typedef_members(tx: &Connection, pid: i64, paths: Option<&HashSet<String>>) -> Result<()> {
+    const COLS: &str = "SELECT id, meta FROM node WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter' \
+                        AND json_extract(meta,'$.tp') IS NOT NULL";
+    let mut members: Vec<(i64, String)> = vec![];
+    match paths {
+        None => {
+            let mut q = tx.prepare(COLS)?;
+            members.extend(q.query_map([pid], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?)))?.flatten());
+        }
+        Some(paths) => {
+            let mut q = tx.prepare_cached(&format!("{COLS} AND path = ?2"))?;
+            let mut sorted: Vec<&String> = paths.iter().collect();
+            sorted.sort();
+            for path in sorted {
+                members.extend(q.query_map(params![pid, path], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?)))?.flatten());
+            }
+        }
+    }
+    if members.is_empty() {
+        return Ok(());
+    }
+    let mut by_name = tx.prepare_cached(
+        "SELECT name, lang, COALESCE(json_extract(meta,'$.ft'),0), json_extract(meta,'$.t') FROM node
+         WHERE project_id = ?1 AND kind = 'symbol' AND name = ?2 COLLATE NOCASE AND source = 'treesitter' AND json_extract(meta,'$.k') = 'type'",
+    )?;
+    let mut memo: HashMap<String, Vec<CTypedef>> = HashMap::new();
+    let mut set = tx.prepare_cached("UPDATE node SET meta = ?2 WHERE id = ?1")?;
+    for (id, meta) in members {
+        let Ok(mut meta) = serde_json::from_str::<serde_json::Value>(&meta) else { continue };
+        let (Some(t), Some(tp)) = (meta["t"].as_str().map(str::to_string), meta["tp"].as_u64()) else { continue };
+        let shape = c_typedef_shape(&t, |n| {
+            memo.entry(n.to_string())
+                .or_insert_with(|| {
+                    by_name
+                        .query_map(params![pid, n], |r| {
+                            Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?, r.get::<_, i64>(2)?, r.get::<_, Option<String>>(3)?))
+                        })
+                        .map(|it| {
+                            it.flatten()
+                                .filter(|(name, lang, ..)| name == n && lang::by_name(lang).is_some_and(|l| l.family == "c"))
+                                .map(|(_, _, ft, t)| (ft as u8, t))
+                                .collect()
+                        })
+                        .unwrap_or_default()
+                })
+                .clone()
+        });
+        let want = shape.is_some_and(|s| u64::from(s) == tp);
+        let is_fn = meta.get("f").is_some();
+        let made = meta.get("fr").is_some();
+        let Some(o) = meta.as_object_mut() else { continue };
+        if want && !is_fn {
+            o.insert("k".into(), "method".into());
+            o.insert("f".into(), 1.into());
+            o.insert("fr".into(), 1.into());
+        } else if !want && made {
+            o.insert("k".into(), "field".into());
+            o.remove("f");
+            o.remove("fr");
+        } else {
+            continue;
+        }
+        set.execute(params![id, meta.to_string()])?;
+    }
+    Ok(())
+}
