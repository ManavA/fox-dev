+/// Changing the typedef in another file changes what the members of that type are: a member
+/// stops being a call target when its typedef stops naming a function pointer, and is one again
+/// when it does.
+#[test]
+fn c_typedef_member_follows_its_typedef_when_it_changes() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = c_typedef_ops_project();
+    let reindex = || {
+        let mut c = db::open_rw().unwrap();
+        inventory::index_project(&mut c, &p).unwrap();
+        tsindex::index_project(&mut c, &p).unwrap();
+    };
+    let types = repo.path().join("include/types.h");
+    let orig = std::fs::read_to_string(&types).unwrap();
+    std::fs::write(&types, orig.replace("typedef int (*op_fn)(int);", "typedef int op_fn;")).unwrap();
+    reindex();
+    let out = fox_code(&p, "ops.stop", "callers", 4000);
+    assert!(!resolved(&out).contains("use.c"), "{out}");
+    std::fs::write(&types, &orig).unwrap();
+    reindex();
+    let out = fox_code(&p, "ops.stop", "callers", 4000);
+    assert!(resolved(&out).contains("1 call sites in 1 files"), "{out}");
+    // Editing the struct's file alone keeps its members typed by the typedef of the other file.
+    let ops = repo.path().join("include/ops.h");
+    let text = std::fs::read_to_string(&ops).unwrap();
+    std::fs::write(&ops, format!("{text}/* edited */\n")).unwrap();
+    reindex();
+    let out = fox_code(&p, "ops.stop", "callers", 4000);
+    assert!(resolved(&out).contains("1 call sites in 1 files") && !resolved(&out).contains("guess"), "{out}");
+    let out = fox_code(&p, "ops.count", "callers", 4000);
+    assert!(!resolved(&out).contains("use.c"), "{out}");
+}
+
+/// A typedef of a function pointer in the same file as the struct needs no other file.
+#[test]
+fn c_typedef_function_pointer_member_in_one_file() {
+    let src = b"typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int plain_t;\ntypedef int fn_t(int);\nstruct ops {\n\top_fn run;\n\top2_fn stop;\n\tfn_t *call;\n\tplain_t n;\n\top_fn *many;\n\top_fn arr[2];\n\tfn_t bare;\n\tunknown_t u;\n};\n";
+    for l in ["c", "cpp"] {
+        let p = tsindex::extract(lang::by_name(l).unwrap(), src);
+        let kind = |n: &str| p.defs.iter().find(|d| d.name == n).map(|d| (d.kind.clone(), d.field_fn)).unwrap();
+        for m in ["run", "stop", "call"] {
+            assert_eq!(kind(m), ("method".to_string(), true), "{l}: {m}");
+        }
+        for f in ["n", "many", "arr", "bare", "u"] {
+            assert_eq!(kind(f), ("field".to_string(), false), "{l}: {f}");
+        }
+        // A typedef of a function pointer is no alias of its return type.
+        let t = p.defs.iter().find(|d| d.name == "op_fn").unwrap();
+        assert!(t.kind == "type" && t.ty.is_none(), "{l}: {t:?}");
+    }
+}
