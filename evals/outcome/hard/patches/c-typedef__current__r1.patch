+/// C/C++: how name `nn` (inside `decl`) is declared a function: 1 a pointer to one
+/// (`(*name)(...)`), 2 a function type (`name(...)`), 0 neither.
+fn c_fn_shape(nn: tree_sitter::Node, decl: tree_sitter::Node) -> u8 {
+    let mut paren = false;
+    let mut cur = nn;
+    for _ in 0..8 {
+        let Some(p) = cur.parent() else { return 0 };
+        if p.id() == decl.id() {
+            return 0;
+        }
+        match p.kind() {
+            "parenthesized_declarator" => paren = true,
+            "function_declarator" => return if paren { 1 } else { 2 },
+            _ => {}
+        }
+        cur = p;
+    }
+    0
+}
+
+/// C/C++: for field name `nn` (inside `decl`), which typedef shape would make it a function
+/// pointer: 1 when it has no `*` (a typedef of a function pointer), 2 when it has exactly one (a
+/// typedef of a function type). 0 for arrays, references, deeper pointers and the like.
+fn c_ptr_slot(nn: tree_sitter::Node, decl: tree_sitter::Node) -> u8 {
+    let mut ptrs = 0u8;
+    let mut cur = nn;
+    for _ in 0..8 {
+        let Some(p) = cur.parent() else { return 0 };
+        if p.id() == decl.id() {
+            return match ptrs {
+                0 => 1,
+                1 => 2,
+                _ => 0,
+            };
+        }
+        match p.kind() {
+            "pointer_declarator" => ptrs += 1,
+            "attributed_declarator" => {}
+            _ => return 0,
+        }
+        cur = p;
+    }
+    0
+}
+
+/// One typedef definition as [`c_typedef_shape`] sees it: its [`Def::fn_type`] and the type it names.
+type CTypedef = (u8, Option<String>);
