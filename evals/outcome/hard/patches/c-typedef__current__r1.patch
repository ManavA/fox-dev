+/// C: what typedef type `t` (`T:op_fn`) is, followed through typedefs of typedefs: 1 a pointer to
+/// a function, 2 a function type. None for any other type, an unknown name, or a name whose
+/// definitions disagree. `lookup` gives the typedefs of a name.
+fn c_typedef_shape(t: &str, mut lookup: impl FnMut(&str) -> Vec<CTypedef>) -> Option<u8> {
+    let mut cur = t.strip_prefix("T:")?.to_string();
