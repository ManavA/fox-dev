+/// A member whose type is a typedef of a function pointer (also through a typedef of a typedef,
+/// or a function type behind a `*`, the typedef in another file) is a function-pointer member:
+/// calls through it reach it, functions stored in it are its dispatch targets. A plain data
+/// field of a typedef type, or a pointer to a function pointer, is no such member.
+#[test]
+fn c_typedef_function_pointer_members_are_calls_targets() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = c_typedef_ops_project();
+    let kind = |name: &str| -> String {
+        let c = db::open_ro().unwrap();
+        c.query_row(
+            "SELECT json_extract(meta,'$.k') FROM node WHERE project_id = ?1 AND name = ?2 AND path LIKE '%.h' AND kind = 'symbol' AND json_extract(meta,'$.parent') IS NOT NULL",
+            rusqlite::params![p.id, name],
+            |r| r.get(0),
+        )
+        .unwrap()
+    };
+    for m in ["run", "stop", "call", "cb"] {
+        assert_eq!(kind(m), "method", "{m}");
+    }
+    for f in ["count", "table"] {
+        assert_eq!(kind(f), "field", "{f}");
+    }
+    for (m, site) in [("run", "use.c (1)"), ("stop", "use.c (1)"), ("call", "use.c (1)")] {
+        let out = fox_code(&p, &format!("ops.{m}"), "callers", 4000);
+        let r = resolved(&out);
+        assert!(r.contains("1 call sites in 1 files") && r.contains(site) && !r.contains("guess"), "{m}: {out}");
+        let out = fox_code(&p, &format!("ops.{m}"), "impact", 4000);
+        assert!(out.contains("implements ops.") || out.contains("impl"), "{m}: {out}");
+    }
+    let out = fox_code(&p, "local_ops.cb", "callers", 4000);
+    assert!(resolved(&out).contains("1 call sites in 1 files") && out.contains("local.c (1)"), "{out}");
+    // Impact of the stored function reaches the caller of the member.
+    for f in ["impl", "impl_stop", "impl_call"] {
+        let out = fox_code(&p, f, "impact", 4000);
+        assert!(out.contains("go"), "{f}: {out}");
+    }
+    let out = fox_code(&p, "impl", "impact", 4000);
+    assert!(out.contains("via ops.run"), "{out}");
+}
