+/// Gives each Python `self`, `cls` and `super()` call its class's method resolution order (see
+/// [`RefRow::mro`]). A class's bases are its resolved `impl` references in written order: the
+/// stored ones, with those just scored (`fresh`: rowid -> (target, ambiguity)) in their place.
+fn set_python_mro(
+    tx: &Connection,
+    refs: &mut [RefRow],
+    parent_of: &HashMap<i64, (i64, bool)>,
+    fresh: &HashMap<i64, (i64, i64)>,
+) -> Result<()> {
+    let mut q = tx.prepare_cached("SELECT rowid, dst, amb FROM ts_ref WHERE src = ?1 AND src != 0 AND kind = 'impl' ORDER BY rowid")?;
+    let mut bases = |k: i64| -> Vec<i64> {
+        let rows: Vec<(i64, i64, i64)> =
+            q.query_map([k], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).map(|it| it.flatten().collect()).unwrap_or_default();
+        let mut out: Vec<i64> = vec![];
+        for (rowid, dst, amb) in rows {
+            let (dst, amb) = fresh.get(&rowid).copied().unwrap_or((dst, amb));
+            if dst != 0 && amb <= 0 && !out.contains(&dst) {
+                out.push(dst);
+            }
+        }
+        out
+    };
+    let mut memo: HashMap<i64, Vec<i64>> = HashMap::new();
+    for r in refs.iter_mut() {
+        let own =
+            r.recv && matches!(r.kind.as_str(), "call" | "ref") && r.via.as_deref().is_some_and(|v| matches!(v, "self" | "cls" | "super"));
+        if !own || lang::for_path(&r.path).is_none_or(|l| l.family != "python") {
+            continue;
+        }
+        // The class the call sits in: the innermost enclosing definition held by a class (a
+        // nested function inside a method uses its method's `self`).
+        let class = r.enclosing.iter().find_map(|e| {
+            let p = parent_of.get(e)?.0;
+            (p != 0 && parent_of.get(&p).is_some_and(|x| !x.1)).then_some(p)
+        });
+        let Some(k) = class else { continue };
+        let order = linearize(k, &mut bases, &mut memo);
+        r.mro = Some(if r.via.as_deref() == Some("super") { order[1..].to_vec() } else { order });
+    }
+    Ok(())
+}
