+/// The method resolution order of class `k` (C3 linearization: `k`, then its bases' orders
+/// merged, left to right, each class once), from `bases` (a class's direct bases in the order
+/// written). A hierarchy Python would reject (no consistent order) falls back to the first
+/// head that is left; a cycle ends the walk.
+pub(crate) fn linearize(k: i64, bases: &mut dyn FnMut(i64) -> Vec<i64>, memo: &mut HashMap<i64, Vec<i64>>) -> Vec<i64> {
+    fn go(k: i64, bases: &mut dyn FnMut(i64) -> Vec<i64>, memo: &mut HashMap<i64, Vec<i64>>, open: &mut Vec<i64>) -> Vec<i64> {
+        if let Some(m) = memo.get(&k) {
+            return m.clone();
+        }
+        if open.contains(&k) || open.len() > 64 {
+            return vec![k];
+        }
+        open.push(k);
+        let direct = bases(k);
+        let mut seqs: Vec<Vec<i64>> = direct.iter().filter(|&&b| b != k).map(|&b| go(b, bases, memo, open)).collect();
+        seqs.push(direct.into_iter().filter(|&b| b != k).collect());
+        open.pop();
+        let mut out = vec![k];
+        loop {
+            seqs.retain(|q| !q.is_empty());
+            if seqs.is_empty() {
+                break;
+            }
+            let head = seqs.iter().map(|q| q[0]).find(|h| !seqs.iter().any(|q| q[1..].contains(h))).unwrap_or(seqs[0][0]);
+            out.push(head);
+            for q in seqs.iter_mut() {
+                if q[0] == head {
+                    q.remove(0);
+                } else {
+                    q.retain(|x| *x != head);
+                }
+            }
+        }
+        memo.insert(k, out.clone());
+        out
+    }
+    go(k, bases, memo, &mut vec![])
+}
