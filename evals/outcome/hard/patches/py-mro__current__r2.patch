+/// Python resolves `self.m()` and `super().m()` along the caller's class's method resolution
+/// order: `class Child(Mixin, Base)` runs Mixin's `step` before Base's, a diamond runs each base
+/// once, and an overriding subclass runs its own. A `super()` call in a mixin also reaches the
+/// method that follows it in a subclass's order.
+#[test]
+fn python_callers_follow_method_resolution_order() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("mro/__init__.py", ""),
+        ("mro/base.py", "class Base:\n    def step(self):\n        return 1\n\n    def run(self):\n        return self.step()\n"),
+        ("mro/mixin.py", "class Mixin:\n    def step(self):\n        return super().step()\n"),
+        (
+            "mro/child.py",
+            "from mro.base import Base\nfrom mro.mixin import Mixin\n\n\nclass Child(Mixin, Base):\n    def go(self):\n        return self.step()\n\n\nclass Plain(Base):\n    def go(self):\n        return self.step()\n",
+        ),
+        (
+            "mro/diamond.py",
+            "class A:\n    def step(self):\n        return 0\n\n\nclass B(A):\n    def step(self):\n        return super().step()\n\n\nclass C(A):\n    def step(self):\n        return super().step()\n\n\nclass D(B, C):\n    def step(self):\n        return super().step()\n\n    def go(self):\n        return self.step()\n\n\nclass E(B, C):\n    def go(self):\n        return self.step()\n\n\nclass F(E):\n    def again(self):\n        return self.step()\n",
+        ),
+    ]);
+    let callers = |sym: &str| resolved(&fox_code(&p, sym, "callers", 4000));
+    // Mixin runs first for a Child; a Plain subclass and Base itself run Base's.
+    let out = callers("Mixin.step");
+    assert!(out.contains("Child.go c:") && !out.contains("Plain.go"), "{out}");
+    let out = callers("Base.step");
+    assert!(out.contains("Plain.go c:") && out.contains("Base.run c:") && !out.contains("Child.go"), "{out}");
+    // Mixin.step's `super().step()` runs Base's for a Child.
+    assert!(out.contains("Mixin.step c:"), "{out}");
+    // Diamond: E and F run B's, D (which overrides) runs its own, and each `super()` goes to the
+    // next class in the order of the instance's class.
+    let out = callers("B.step");
+    assert!(out.contains("E.go c:") && out.contains("F.again c:") && out.contains("D.step c:") && !out.contains("D.go"), "{out}");
+    let out = callers("D.step");
+    assert!(out.contains("D.go c:") && !out.contains("E.go"), "{out}");
+    let out = callers("C.step");
+    assert!(out.contains("B.step c:") && !out.contains("D.step") && !out.contains("E.go"), "{out}");
+    let out = callers("A.step");
+    assert!(out.contains("B.step c:") && out.contains("C.step c:") && !out.contains("D.step"), "{out}");
+}
