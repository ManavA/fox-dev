+/// A reference's target, ambiguity and slot.
+type Scored = (i64, i64, i64);
+
+/// Keep `ts_ref_alt` (the further methods one reference reaches, see [`Mro::resolve`]) as the
+/// re-scored references left it, and drop rows of references that no longer exist.
+fn write_alts(tx: &Connection, refs: &[RefRow], scored: &[Scored], alts: &[Vec<i64>]) -> Result<()> {
+    let mut old: HashMap<i64, Vec<i64>> = HashMap::new();
+    {
+        let mut q = tx.prepare_cached("SELECT ref, dst FROM ts_ref_alt")?;
+        for row in q.query_map([], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)))?.flatten() {
+            old.entry(row.0).or_default().push(row.1);
+        }
+    }
+    if old.is_empty() && alts.iter().all(Vec::is_empty) {
+        return Ok(());
+    }
+    let mut del = tx.prepare_cached("DELETE FROM ts_ref_alt WHERE ref = ?1")?;
+    let mut ins = tx.prepare_cached("INSERT OR IGNORE INTO ts_ref_alt(ref, dst) VALUES (?1, ?2)")?;
+    for ((r, s), alt) in refs.iter().zip(scored).zip(alts) {
+        // A precise (SCIP) target stands alone.
+        let alt: &[i64] = if s.1 == -1 { &[] } else { alt };
+        let mut was = old.remove(&r.rowid).unwrap_or_default();
+        was.sort_unstable();
+        let mut now = alt.to_vec();
+        now.sort_unstable();
+        if was != now {
+            del.execute([r.rowid])?;
+            for d in alt {
+                ins.execute(params![r.rowid, d])?;
+            }
+        }
+    }
+    tx.execute("DELETE FROM ts_ref_alt WHERE ref NOT IN (SELECT rowid FROM ts_ref)", [])?;
+    Ok(())
+}
