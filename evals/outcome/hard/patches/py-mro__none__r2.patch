+/// A changed base list re-points `self.m()` in the files of the classes below it, too.
+#[test]
+fn python_mro_follows_an_edited_base_list() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = inline_project(&[
+        ("ed/__init__.py", ""),
+        ("ed/base.py", "class Base:\n    def step(self):\n        return 1\n"),
+        ("ed/mixin.py", "class Mixin:\n    def step(self):\n        return 2\n"),
+        ("ed/child.py", "from ed.base import Base\nfrom ed.mixin import Mixin\n\n\nclass Child(Mixin, Base):\n    pass\n"),
+        ("ed/leaf.py", "from ed.child import Child\n\n\nclass Leaf(Child):\n    def run(self):\n        return self.step()\n"),
+    ]);
+    let who = |parent: &str| -> String {
+        let c = db::open_ro().unwrap();
+        let id: i64 =
+            c.query_row("SELECT id FROM node WHERE name = 'step' AND json_extract(meta,'$.parent') = ?1", [parent], |r| r.get(0)).unwrap();
+        fox_code(&p, &format!("c:{id:x}"), "callers", 2000)
+    };
+    assert!(who("Mixin").contains("Leaf.run") && !who("Base").contains("Leaf.run"));
+    std::fs::write(
+        repo.path().join("ed/child.py"),
+        "from ed.base import Base\nfrom ed.mixin import Mixin\n\n\nclass Child(Base, Mixin):\n    pass  # reordered\n",
+    )
+    .unwrap();
+    let mut c = db::open_rw().unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    assert!(who("Base").contains("Leaf.run") && !who("Mixin").contains("Leaf.run"), "{}\n{}", who("Base"), who("Mixin"));
+}
