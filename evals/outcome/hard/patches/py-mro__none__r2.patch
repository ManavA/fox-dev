+/// Python: `self.m()` reaches the first class on the method resolution order that defines `m`
+/// (a mixin before the base), through diamonds and overriding subclasses, and `super().m()` the
+/// next one after its own class, which for a mixin is what the classes below it put next.
+#[test]
+fn python_calls_follow_the_method_resolution_order() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("mro/__init__.py", ""),
+        ("mro/base.py", "class Base:\n    def step(self):\n        return 1\n\n    def only_base(self):\n        return 0\n"),
+        ("mro/mixin.py", "class Mixin:\n    def step(self):\n        return super().step()\n"),
+        (
+            "mro/child.py",
+            "from mro.base import Base\nfrom mro.mixin import Mixin\n\n\nclass Child(Mixin, Base):\n    def run(self):\n        self.only_base()\n        return self.step()\n",
+        ),
+        (
+            "mro/grand.py",
+            "from mro.child import Child\n\n\nclass Grand(Child):\n    def step(self):\n        return super().step()\n\n    def go(self):\n        return self.step()\n",
+        ),
+        (
+            "mro/diamond.py",
+            "class A:\n    def hook(self):\n        pass\n\n\nclass B(A):\n    def hook(self):\n        super().hook()\n\n\nclass C(A):\n    def hook(self):\n        super().hook()\n\n\nclass D(B, C):\n    def go(self):\n        self.hook()\n\n\nclass E(C, B):\n    def go(self):\n        self.hook()\n",
+        ),
+    ]);
+    let c = db::open_ro().unwrap();
+    let id = |name: &str, parent: &str| -> String {
+        let id: i64 = c
+            .query_row(
+                "SELECT id FROM node WHERE name = ?1 AND kind = 'symbol' AND json_extract(meta,'$.parent') = ?2",
+                [name, parent],
+                |r| r.get(0),
+            )
+            .unwrap();
+        format!("c:{id:x}")
+    };
+    let callers = |name: &str, parent: &str| -> String {
+        // Caller rows only: ` :LINE Class.method c:ID`.
+        fox_code(&p, &id(name, parent), "callers", 2000).lines().filter(|l| l.starts_with("  :")).map(|l| format!("{l}\n")).collect()
+    };
+    // Child.run runs Mixin.step, not Base.step.
+    let out = callers("step", "Mixin");
+    assert!(out.contains("Child.run"), "{out}");
+    assert!(out.contains("Grand.step"), "{out}");
+    let out = callers("step", "Base");
+    assert!(!out.contains("Child.run") && !out.contains("Grand.go"), "{out}");
+    // Mixin's `super().step()` runs Base.step (through Child's order), not itself.
+    assert!(out.contains("Mixin.step"), "{out}");
+    {
+        let m = callers("step", "Mixin");
+        assert!(!m.contains("Mixin.step c:"), "{m}");
+    }
+    // A subclass that overrides: `self.step()` in Grand runs Grand.step; its super() runs Mixin's.
+    let out = callers("step", "Grand");
+    assert!(out.contains("Grand.go"), "{out}");
+    assert!(!callers("step", "Mixin").contains("Grand.go"));
+    // A method only the base defines stays the base's.
+    assert!(callers("only_base", "Base").contains("Child.run"));
+    // Diamond: D(B, C) runs B.hook then C.hook then A.hook through super(); E(C, B) the reverse.
+    let b = callers("hook", "B");
+    let cc = callers("hook", "C");
+    let a = callers("hook", "A");
+    assert!(b.contains("D.go") && !b.contains("E.go"), "{b}");
+    assert!(cc.contains("E.go") && !cc.contains("D.go"), "{cc}");
+    assert!(cc.contains("B.hook"), "{cc}");
+    // A.hook is reached by C.hook's super() (after B in D's order) and B.hook's (in E's order, last).
+    assert!(a.contains("C.hook") && a.contains("B.hook"), "{a}");
+}
