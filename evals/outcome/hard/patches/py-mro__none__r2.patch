+/// Python: a call or reference through the enclosing object (`self.m()`, `cls.m()`) or its
+/// next base (`super().m()`) inside a class, whose target follows the method resolution order.
+fn mro_ref(r: &RefRow) -> bool {
+    r.caller_class > 0 && mro_via(r)
+}
+
+/// [`mro_ref`], before the calling class is known.
+fn mro_via(r: &RefRow) -> bool {
+    r.recv
+        && matches!(r.kind.as_str(), "call" | "ref")
+        && r.via.as_deref().is_some_and(|v| matches!(v, "self" | "cls" | "super"))
+        && lang::for_path(&r.path).is_some_and(|l| l.family == "python")
+}
+
+/// Most steps up (bases of bases) and down (subclasses of subclasses) the hierarchy followed.
+const MRO_STEPS: usize = 12;
+/// Most classes the hierarchy of one resolution holds.
+const MRO_CLASSES: usize = 20_000;
+
+/// Python classes' linearizations (C3, as the interpreter computes them). A negative id stands for
+/// a base outside the project (or one resolved only by a guess), the same for the same name.
+#[derive(Default)]
+struct Mro {
+    /// Class -> itself followed by its ancestors, nearest first.
+    lin: HashMap<i64, Vec<i64>>,
+    /// Class -> the classes below it whose linearization contains it, in id order.
+    subs: HashMap<i64, Vec<i64>>,
+}
+
+/// The id standing for the base class `name` that no project class resolves to.
+fn outside_class(name: &str) -> i64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    name.hash(&mut h);
+    -((h.finish() >> 2) as i64) - 1
+}
+
+/// C3 linearization of `c` from the ordered `bases`; None when the hierarchy is inconsistent.
+fn c3(c: i64, bases: &HashMap<i64, Vec<i64>>, memo: &mut HashMap<i64, Option<Vec<i64>>>, depth: usize) -> Option<Vec<i64>> {
+    if let Some(m) = memo.get(&c) {
+        return m.clone();
+    }
+    if depth > MRO_STEPS {
+        return None;
+    }
+    // A cycle ends as a failure.
+    memo.insert(c, None);
+    let own = bases.get(&c).map(Vec::as_slice).unwrap_or(&[]);
+    let mut seqs: Vec<Vec<i64>> = vec![];
+    for &b in own {
+        seqs.push(if b < 0 { vec![b] } else { c3(b, bases, memo, depth + 1)? });
+    }
+    seqs.push(own.to_vec());
+    let mut out = vec![c];
+    loop {
+        seqs.retain(|s| !s.is_empty());
+        if seqs.is_empty() {
+            break;
+        }
+        let head = seqs.iter().map(|s| s[0]).find(|h| !seqs.iter().any(|s| s[1..].contains(h)))?;
+        out.push(head);
+        for s in seqs.iter_mut() {
+            if s[0] == head {
+                s.remove(0);
+            }
+        }
+    }
+    memo.insert(c, Some(out.clone()));
+    Some(out)
+}
+
+/// The hierarchy of the classes the Python `self`/`cls`/`super` references of `refs` sit in:
+/// their ancestors, and for `super()` also their subclasses (the next class after one in a
+/// subclass's order may be a sibling).
+fn build_mro(tx: &Connection, refs: &[RefRow], cands: &HashMap<String, Vec<Cand>>, imports: &HashMap<String, FileImports>) -> Result<Mro> {
+    let mut want: Vec<i64> = vec![];
+    let mut supers: Vec<i64> = vec![];
+    for r in refs.iter().filter(|r| mro_ref(r)) {
+        want.push(r.caller_class);
+        if r.via.as_deref() == Some("super") {
+            supers.push(r.caller_class);
+        }
+    }
+    if want.is_empty() {
+        return Ok(Mro::default());
+    }
+    want.sort_unstable();
+    want.dedup();
+    supers.sort_unstable();
+    supers.dedup();
+    // The base references this run re-scores take their new targets; the rest keep the stored ones.
+    let fresh: HashMap<i64, (i64, i64)> = refs
+        .par_iter()
+        .filter(|r| r.kind == "impl" && lang::for_path(&r.path).is_some_and(|l| l.family == "python"))
+        .map(|r| (r.rowid, score(r, cands.get(&r.name).map(Vec::as_slice).unwrap_or(&[]), imports.get(&r.path))))
+        .collect();
+    let mut by_src =
+        tx.prepare_cached("SELECT rowid, dst, amb, name FROM ts_ref WHERE src = ?1 AND src != 0 AND kind = 'impl' ORDER BY rowid")?;
+    let mut by_dst =
+        tx.prepare_cached("SELECT rowid, src FROM ts_ref WHERE dst = ?1 AND dst != 0 AND amb <= 0 AND kind = 'impl' AND src != 0")?;
+    let mut bases: HashMap<i64, Vec<i64>> = HashMap::new();
+    let mut load = |start: &[i64], bases: &mut HashMap<i64, Vec<i64>>| -> Result<()> {
+        let mut todo: Vec<i64> = start.to_vec();
+        for _ in 0..MRO_STEPS {
+            let mut next = vec![];
+            for c in todo {
+                if bases.contains_key(&c) || bases.len() >= MRO_CLASSES {
+                    continue;
+                }
+                let mut v = vec![];
+                for row in by_src
+                    .query_map([c], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?, r.get::<_, i64>(2)?, r.get::<_, String>(3)?)))?
+                {
+                    let (rowid, dst, amb, name) = row?;
+                    let (dst, amb) = fresh.get(&rowid).copied().unwrap_or((dst, amb));
+                    if name == "object" {
+                        continue;
+                    }
+                    if dst != 0 && amb <= 0 && dst != c {
+                        v.push(dst);
+                        next.push(dst);
+                    } else {
+                        v.push(outside_class(&name));
+                    }
+                }
+                bases.insert(c, v);
+            }
+            if next.is_empty() {
+                break;
+            }
+            todo = next;
+        }
+        Ok(())
+    };
+    load(&want, &mut bases)?;
+    // Subclasses of the classes `super()` is called in.
+    let mut subs_of: HashMap<i64, Vec<i64>> = HashMap::new();
+    for &c in &supers {
+        let mut seen: HashSet<i64> = HashSet::from([c]);
+        let mut frontier = vec![c];
+        for _ in 0..MRO_STEPS {
+            let mut next = vec![];
+            for x in frontier {
+                let mut below: Vec<i64> = fresh.iter().filter(|(_, v)| v.0 == x && v.1 <= 0).map(|(&rowid, _)| rowid).collect();
+                below.sort_unstable();
+                let mut srcs: Vec<i64> = vec![];
+                for row in by_dst.query_map([x], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)))? {
+                    let (rowid, src) = row?;
+                    if !fresh.contains_key(&rowid) {
+                        srcs.push(src);
+                    }
+                }
+                srcs.extend(below.iter().filter_map(|rowid| refs.iter().find(|r| r.rowid == *rowid).map(|r| r.src)));
+                for s in srcs {
+                    if seen.len() < 500 && seen.insert(s) {
+                        next.push(s);
+                    }
+                }
+            }
+            if next.is_empty() {
+                break;
+            }
+            frontier = next;
+        }
+        seen.remove(&c);
+        subs_of.insert(c, seen.into_iter().collect());
+    }
+    let below: Vec<i64> = subs_of.values().flatten().copied().collect();
+    load(&below, &mut bases)?;
+    let mut memo: HashMap<i64, Option<Vec<i64>>> = HashMap::new();
+    let mut mro = Mro::default();
+    for &c in want.iter().chain(&below) {
+        if let Some(l) = c3(c, &bases, &mut memo, 0) {
+            mro.lin.insert(c, l);
+        }
+    }
+    for (c, mut v) in subs_of {
+        v.retain(|d| mro.lin.get(d).is_some_and(|l| l.contains(&c)));
+        v.sort_unstable();
+        mro.subs.insert(c, v);
+    }
+    Ok(mro)
+}
+
+impl Mro {
+    /// The method `r.name` that Python runs for `self.name()` / `cls.name()` / `super().name()`
+    /// in the class `r` sits in, and for `super()` the other methods it reaches through the
+    /// order of a subclass (a diamond's sibling); None when the order does not tell (a base from
+    /// outside the project comes first, or no class on it defines the name).
+    fn resolve(&self, r: &RefRow, cands: &[Cand]) -> Option<(i64, Vec<i64>)> {
+        if !mro_ref(r) {
+            return None;
+        }
+        let c = r.caller_class;
+        let lin = self.lin.get(&c)?;
+        let defines = |id: i64| cands.iter().find(|s| s.pid == id && s.family == "python" && is_callable_kind(&s.kind)).map(|s| s.id);
+        // The first class on `order` that defines the name: Some(None) when one from outside the
+        // project is reached first.
+        let first = |order: &[i64]| -> Option<Option<i64>> {
+            for &k in order {
+                if k < 0 {
+                    return Some(None);
+                }
+                if let Some(d) = defines(k) {
+                    return Some(Some(d));
+                }
+            }
+            None
+        };
+        if r.via.as_deref() != Some("super") {
+            return first(lin).flatten().map(|d| (d, vec![]));
+        }
+        // `super()`: the next class after this one that defines it, and what the classes below
+        // it reach after it (the only way for a mixin with no base, a sibling in a diamond).
+        let mut targets: Vec<i64> = first(&lin[1..]).flatten().into_iter().collect();
+        let mut below: Vec<i64> = vec![];
+        for d in self.subs.get(&c).into_iter().flatten() {
+            let l = &self.lin[d];
+            let at = l.iter().position(|&k| k == c)?;
+            if let Some(Some(t)) = first(&l[at + 1..])
+                && !targets.contains(&t)
+                && !below.contains(&t)
+            {
+                below.push(t);
+            }
+        }
+        below.sort_unstable();
+        targets.extend(below);
+        let rest = targets.split_off(targets.len().min(1));
+        Some((targets.first().copied().unwrap_or(0), rest))
+    }
+}
+
+/// [`score`], following the method resolution order for Python `self`/`cls`/`super` calls.
+fn score_mro(r: &RefRow, cands: &[Cand], imp: Option<&FileImports>, mro: &Mro) -> (i64, i64, Vec<i64>) {
+    match mro.resolve(r, cands) {
+        Some((d, alt)) => (d, 0, alt),
+        None => {
+            let (d, a) = score(r, cands, imp);
+            (d, a, vec![])
+        }
+    }
+}
