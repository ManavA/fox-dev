+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = inline_project(&[
+        (
+            "car.hpp",
+            "struct Pump { void start() {} };\nstruct Fan { void start() {} };\nstruct Base { void start() {} };\nstruct Kid { };\nstruct Car {\n  Pump part;\n};\n",
+        ),
+        ("use.cpp", "#include \"car.hpp\"\nvoid f(Car& c, Kid& k) {\n  c.part.start();\n  k.start();\n}\n"),
+    ]);
+    let certain = |sym: &str| certain_calls(&fox_code(&p, sym, "callers", 4000));
+    assert_eq!((certain("Pump.start"), certain("Fan.start"), certain("Base.start")), (1, 0, 0));
+    let mut c = db::open_rw().unwrap();
+    let h = repo.path().join("car.hpp");
+    let text = std::fs::read_to_string(&h).unwrap();
+    std::fs::write(&h, text.replace("Pump part;", "Fan part;").replace("struct Kid { };", "struct Kid : Base { };")).unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    assert_eq!(tsindex::index_project(&mut c, &p).unwrap().parsed, 1);
+    let certain = |sym: &str| certain_calls(&fox_code(&p, sym, "callers", 4000));
+    assert_eq!((certain("Pump.start"), certain("Fan.start"), certain("Base.start")), (0, 1, 1));
+    let snap = |c: &rusqlite::Connection| -> Vec<(i64, i64, i64)> {
+        let mut q = c.prepare("SELECT rowid, dst, amb FROM ts_ref ORDER BY rowid").unwrap();
+        q.query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).unwrap().flatten().collect()
