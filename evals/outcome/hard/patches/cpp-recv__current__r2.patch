+/// C++ member calls resolve through the receiver's declared or inferred type: a local, a
+/// parameter (pointer, reference, value), a member of a typed struct, `auto` from a constructor
+/// call, `make_unique` or `new`. The right class gets them with certainty; a receiver whose type
+/// can't be told stays a guess.
+#[test]
+fn cpp_member_calls_resolve_through_the_receivers_type() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        (
+            "engine.hpp",
+            "struct Engine {\n  void start();\n  int rpm;\n};\nstruct Pump {\n  void start();\n};\nstruct Fan {\n  void start();\n};\nstruct Car {\n  Engine engine;\n  Pump *pump;\n  std::unique_ptr<Fan> fan;\n};\n",
+        ),
+        ("engine.cpp", "#include \"engine.hpp\"\nvoid Engine::start() {}\nvoid Pump::start() {}\nvoid Fan::start() {}\n"),
+        (
+            "use.cpp",
+            "#include \"engine.hpp\"\nvoid local_engine() {\n  Engine e;\n  e.start();\n}\nvoid ptr_param(Pump* p) {\n  p->start();\n}\nvoid ref_param(const Pump& p) {\n  p.start();\n}\nvoid auto_engine() {\n  auto e = Engine();\n  e.start();\n}\nvoid auto_pump() {\n  auto p = std::make_unique<Pump>();\n  p->start();\n}\nvoid auto_new() {\n  auto e = new Engine();\n  e->start();\n}\nvoid member_chain(Car& car, Car* cp) {\n  car.engine.start();\n  cp->pump->start();\n  cp->fan->start();\n}\nvoid unknown(T& t) {\n  t.start();\n}\nvoid unknown2() {\n  auto x = make();\n  x.start();\n}\n",
+        ),
+    ]);
+    let calls = |sym: &str| fox_code(&p, sym, "callers", 4000);
+    // Engine: a local, `auto e = Engine()`, `auto e = new Engine()`, `car.engine`.
+    let out = calls("Engine.start");
+    assert_eq!(certain_calls(&out), 4, "{out}");
+    for l in [":4 local_engine", ":14 auto_engine", ":22 auto_new", ":25 member_chain"] {
+        assert!(out.lines().any(|x| x.contains(l) && !x.contains("guess")), "missing {l}: {out}");
+    }
+    // Pump: a pointer parameter, a const reference parameter, `make_unique`, `cp->pump`.
