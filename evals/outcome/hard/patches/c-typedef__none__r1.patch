+/// The typedef beside the struct in one file: the member is a function member at extraction.
+#[test]
+fn c_typedef_function_pointer_member_in_one_file() {
+    let src = b"typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int cnt_t;\nstruct ops { op_fn run; op2_fn run2; cnt_t n; op_fn *tbl; };\n";
+    let p = tsindex::extract(lang::by_name("c").unwrap(), src);
+    let got: Vec<(&str, &str)> = p.defs.iter().filter(|d| d.container.is_some()).map(|d| (d.name.as_str(), d.kind.as_str())).collect();
+    assert_eq!(got, [("run", "method"), ("run2", "method"), ("n", "field"), ("tbl", "field")]);
+}
