+/// How many typedef steps [`link_fn_typedefs`] follows from a member's type name.
+const FN_TYPEDEF_STEPS: usize = 4;
+
+/// What typedef `name` is: 1 a function pointer, 2 a function type, through typedefs of typedefs;
+/// 0 when it is neither or its definitions disagree.
+fn fn_typedef_level(q: &mut rusqlite::Statement, pid: i64, name: &str, steps: usize, cache: &mut HashMap<String, u8>) -> Result<u8> {
+    if let Some(l) = cache.get(name) {
+        return Ok(*l);
+    }
+    if steps == 0 {
+        return Ok(0);
+    }
+    let rows: Vec<(String, i64, Option<String>)> =
+        q.query_map(params![pid, name], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)))?.flatten().filter(|(n, _, _)| n == name).collect();
+    let mut levels: HashSet<u8> = HashSet::new();
+    for (_, fp, t) in rows {
+        levels.insert(match (fp, t.as_deref().and_then(|t| t.strip_prefix("T:"))) {
+            (0, Some(next)) => fn_typedef_level(q, pid, next, steps - 1, cache)?,
+            (fp, _) => fp as u8,
+        });
+    }
+    let l = if levels.len() == 1 { levels.into_iter().next().unwrap_or(0) } else { 0 };
+    cache.insert(name.to_string(), l);
+    Ok(l)
+}
