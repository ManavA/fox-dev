+/// C/C++: a member whose type is a typedef of a function pointer (`typedef int (*op_fn)(int);
+/// struct ops { op_fn run; }`, or of a function type behind a pointer: `op_t *run;`), through
+/// typedefs of typedefs, is a function-pointer member like `int (*run)(int)`. The typedef may be
+/// in another file than the struct, so this runs once every file of a run is stored. Looks at the
+/// members of `paths` only (all when None). Returns the member names and structs whose kind changed.
+fn link_fn_typedefs(tx: &Connection, pid: i64, paths: Option<&HashSet<String>>) -> Result<HashSet<String>> {
+    type Row = (i64, String, String);
+    let cols = "SELECT id, name, meta FROM node WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter'
+                AND json_extract(meta,'$.sh') IS NOT NULL";
+    let mut rows: Vec<Row> = vec![];
+    let get = |r: &rusqlite::Row| -> rusqlite::Result<Row> { Ok((r.get(0)?, r.get(1)?, r.get(2)?)) };
+    match paths {
+        None => rows.extend(tx.prepare(cols)?.query_map([pid], get)?.flatten()),
+        Some(paths) => {
+            let mut q = tx.prepare(&format!("{cols} AND path = ?2"))?;
+            for path in paths.iter().filter(|p| is_c_path(p) || is_header(p)) {
+                rows.extend(q.query_map(params![pid, path], get)?.flatten());
+            }
+        }
+    }
+    let mut changed = HashSet::new();
+    if rows.is_empty() {
+        return Ok(changed);
+    }
+    let mut types = tx.prepare(
+        "SELECT name, COALESCE(json_extract(meta,'$.fp'),0), json_extract(meta,'$.t') FROM node
+         WHERE project_id = ?1 AND name = ?2 COLLATE NOCASE AND kind = 'symbol' AND source = 'treesitter'
+           AND json_extract(meta,'$.k') = 'type'",
+    )?;
+    let mut cache: HashMap<String, u8> = HashMap::new();
+    let mut upd = tx.prepare_cached("UPDATE node SET meta = ?2 WHERE id = ?1")?;
+    for (id, name, meta) in rows {
+        let Ok(mut m) = serde_json::from_str::<serde_json::Value>(&meta) else { continue };
+        let ty = m["t"].as_str().and_then(|t| t.strip_prefix("T:")).unwrap_or("").to_string();
+        let level = fn_typedef_level(&mut types, pid, &ty, FN_TYPEDEF_STEPS, &mut cache)?;
+        let want = matches!((m["sh"].as_u64(), level), (Some(0), 1) | (Some(1), 2));
+        if want == m.get("f").is_some() {
+            continue;
+        }
+        if want {
+            m["f"] = 1.into();
+            m["k"] = "method".into();
+        } else {
+            if let Some(o) = m.as_object_mut() {
+                o.remove("f");
+            }
+            m["k"] = FIELD.into();
+        }
+        upd.execute(params![id, m.to_string()])?;
+        changed.insert(name);
+        if let Some(parent) = m["parent"].as_str().and_then(|p| p.rsplit('.').next()).filter(|p| !p.is_empty()) {
+            changed.insert(parent.to_string());
+        }
+    }
+    Ok(changed)
+}
