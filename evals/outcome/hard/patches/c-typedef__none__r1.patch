+/// C/C++: members typed by a function-pointer typedef of the same file are function members at
+/// once; those typed by another file's typedef wait for [`link_fn_typedefs`].
+fn local_fn_typedefs(out: &mut Parsed) {
+    let mut by_name: HashMap<&str, HashSet<(u8, Option<&str>)>> = HashMap::new();
+    for d in out.defs.iter().filter(|d| d.kind == "type") {
+        by_name.entry(d.name.as_str()).or_default().insert((d.fp, d.ty.as_deref().and_then(|t| t.strip_prefix("T:"))));
+    }
+    let level = |name: &str| -> u8 {
+        let mut cur = name;
+        for _ in 0..FN_TYPEDEF_STEPS {
+            let Some(v) = by_name.get(cur).filter(|v| v.len() == 1) else { return 0 };
+            match v.iter().next() {
+                Some((0, Some(next))) => cur = next,
+                Some((fp, _)) => return *fp,
+                None => return 0,
+            }
+        }
+        0
+    };
+    let hits: Vec<usize> = (0..out.defs.len())
+        .filter(|&i| {
+            let d = &out.defs[i];
+            let lv = d.ty.as_deref().and_then(|t| t.strip_prefix("T:")).map_or(0, level);
+            matches!((d.shape, lv), (Some(0), 1) | (Some(1), 2))
+        })
+        .collect();
+    for i in hits {
+        out.defs[i].field_fn = true;
+        out.defs[i].kind = "method".into();
+    }
+}
