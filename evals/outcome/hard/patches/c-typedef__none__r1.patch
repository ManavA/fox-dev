+/// A member whose type is a typedef of a function pointer (also a typedef of a typedef, or of a
+/// function type behind a pointer) is a function-pointer member; a data field of a typedef type
+/// is not. The typedef may sit in another file, and editing it moves the members with it.
+#[test]
+fn c_typedef_function_pointer_members_are_function_members() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = inline_project(&[
+        ("types.h", "typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int op_t(int);\ntypedef int count_t;\n"),
+        ("ops.h", "#include \"types.h\"\nstruct ops {\n\top_fn run;\n\top2_fn run2;\n\top_t *run3;\n\tcount_t n;\n\top_fn *tbl;\n};\n"),
+        (
+            "impl.c",
+            "#include \"ops.h\"\nstatic int impl(int x) { return x; }\nstatic int impl2(int x) { return x; }\nstatic int impl3(int x) { return x; }\nstatic struct ops o = {\n\t.run = impl,\n\t.run2 = impl2,\n\t.run3 = impl3,\n};\n",
+        ),
+        (
+            "call.c",
+            "#include \"ops.h\"\nint use(struct ops *o, int x) { return o->run(x) + o->run2(x) + o->run3(x); }\nint count(struct ops *o) { return o->n; }\n",
+        ),
+    ]);
+    for (m, f) in [("run", "impl"), ("run2", "impl2"), ("run3", "impl3")] {
+        let callers = fox_code(&p, &format!("ops.{m}"), "callers", 4000);
+        assert!(callers.contains("call.c") && callers.contains("use c:"), "{m}: {callers}");
+        let out = fox_code(&p, f, "impact", 4000);
+        assert!(out.contains(&format!("via ops.{m}")) && out.contains("use c:"), "{f}: {out}");
+    }
+    let n = fox_code(&p, "ops.n", "callers", 4000);
+    assert!(!n.contains("use c:"), "{n}");
+    // The typedef changes to plain data: its members stop being function members.
+    let mut c = db::open_rw().unwrap();
+    let h = repo.path().join("types.h");
+    std::fs::write(&h, "typedef int op_fn;\ntypedef op_fn op2_fn;\ntypedef int op_t(int);\ntypedef int count_t;\n").unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    let run = fox_code(&p, "ops.run", "callers", 4000);
+    let run3 = fox_code(&p, "ops.run3", "callers", 4000);
+    assert!(!run.contains("use c:") && run3.contains("use c:"), "{run}\n{run3}");
+    let snap = |c: &rusqlite::Connection| -> Vec<(i64, i64, i64)> {
+        let mut q = c.prepare("SELECT rowid, dst, slot FROM ts_ref ORDER BY rowid").unwrap();
+        q.query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).unwrap().flatten().collect()
+    };
+    let inc = snap(&c);
+    tsindex::resolve(&c, p.id).unwrap();
+    assert_eq!(snap(&c), inc);
+    // And back.
+    std::fs::write(&h, "typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int op_t(int);\ntypedef int count_t;\n").unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    assert!(fox_code(&p, "ops.run2", "callers", 4000).contains("use c:"));
+}
