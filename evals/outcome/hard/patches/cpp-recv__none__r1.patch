+/// A C++ member call is resolved through its receiver's type, not its name: a local, a
+/// parameter (pointer, reference, const reference), a member of a typed struct (read through a
+/// parameter or as a bare name or `this->` inside a method of its class), `auto x = Engine();`
+/// and `auto p = std::make_unique<Pump>();` reach the right class with certainty; a receiver
+/// whose type is unknown stays a guess.
+#[test]
+fn cpp_member_calls_resolve_through_the_receivers_type() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = cpp_project();
+    let out = fox_code(&p, "Engine.start", "callers", 4000);
+    let (sure, guessed) = call_lines(&out);
+    // Engine::start: the local, the auto, the bare member name in Boat::go and the one read through a parameter.
+    for f in ["autos.cpp (1)", "boat.cpp (1)", "local.cpp (1)", "member.cpp (1)"] {
+        assert!(out.contains(f), "missing {f}: {out}");
+    }
+    assert!(!out.contains("param.cpp"), "{out}");
+    assert_eq!(sure.len(), 4, "{out}");
+    // The two calls on receivers of unknown type are guesses.
+    assert_eq!(guessed.len(), 2, "{out}");
+    assert!(out.contains("6 call sites in 5 files, 2 guessed by name"), "{out}");
+    let out = fox_code(&p, "Pump.start", "callers", 4000);
+    let (sure, guessed) = call_lines(&out);
+    for f in ["autos.cpp (1)", "boat.cpp (1)", "member.cpp (1)", "param.cpp (2)"] {
+        assert!(out.contains(f), "missing {f}: {out}");
+    }
+    assert!(sure.len() == 5 && guessed.is_empty(), "{out}");
+    assert!(out.contains("5 call sites in 4 files") && !out.contains("local.cpp"), "{out}");
+    // `this->engine.stop()` is the only caller of Engine::stop.
+    let out = fox_code(&p, "Engine.stop", "callers", 4000);
+    assert!(out.contains("boat.cpp (1)") && !out.contains("guess"), "{out}");
+}
