+    let h = repo.path().join("shapes.hpp");
+    let text = std::fs::read_to_string(&h).unwrap();
+    std::fs::write(&h, format!("// shapes\n{}", text.replace("Square sq;", "Circle sq;"))).unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    assert_eq!(tsindex::index_project(&mut c, &p).unwrap().parsed, 1);
+    assert!(callers("Square.draw").0.is_empty() && callers("Square.draw").1.is_empty());
+    let moved = callers("Circle.draw");
+    assert!(moved.0.len() == 1 && moved.0[0].contains("h.sq.draw()") && moved.1.is_empty(), "{moved:?}");
+    let snap = |c: &rusqlite::Connection| -> Vec<(i64, i64, i64)> {
+        let mut q = c.prepare("SELECT rowid, dst, amb FROM ts_ref ORDER BY rowid").unwrap();
+        q.query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).unwrap().flatten().collect()
+    };
+    let inc = snap(&c);
+    tsindex::resolve(&c, p.id).unwrap();
+    assert_eq!(snap(&c), inc);
+}
+
+/// A `.h` file is parsed as C: the fields of a struct declared there still type a member call.
+#[test]
+fn cpp_member_calls_through_structs_of_c_headers() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("fleet.h", "struct Boat {\n    Engine engine;\n    Pump *pump;\n};\n"),
+        ("parts.cpp", "class Engine { public: void start() {} };\nclass Pump { public: void start() {} };\n"),
+        ("use.cpp", "#include \"fleet.h\"\nvoid d(Boat &b) { b.engine.start(); }\nvoid e(Boat *b) { b->pump->start(); }\n"),
+    ]);
+    let out = fox_code(&p, "Engine.start", "callers", 4000);
+    assert!(out.contains(":2 d c:") && !out.contains("guess") && !out.contains(":3 e c:"), "{out}");
+    let out = fox_code(&p, "Pump.start", "callers", 4000);
+    assert!(out.contains(":3 e c:") && !out.contains("guess") && !out.contains(":2 d c:"), "{out}");
+}
