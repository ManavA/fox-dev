+/// The caller lines of a `callers` answer that are not marked as guesses, and the ones that are.
+fn call_lines(out: &str) -> (Vec<String>, Vec<String>) {
+    let mut sure = vec![];
+    let mut guessed = vec![];
+    for l in out.lines().filter(|l| l.trim_start().starts_with(':') && l.contains(" | ")) {
+        if l.contains("guess") { &mut guessed } else { &mut sure }.push(l.to_string());
+    }
+    (sure, guessed)
+}
