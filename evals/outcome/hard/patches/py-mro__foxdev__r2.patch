+    assert!(!out.contains("Child.run"), "{out}");
+    // Diamond: `super()` in B and C reaches A when alone, but B's reaches C under D.
+    let out = callers("A.step");
+    assert!(out.contains(":8 B.step c:") && out.contains(":13 C.step c:"), "{out}");
+    assert!(!out.contains("D.step") && !out.contains("D.run"), "{out}");
+    let out = callers("C.step");
+    assert!(out.contains(":8 B.step c:"), "{out}");
+    let out = callers("B.step");
+    assert!(out.contains(":18 D.step c:") && !out.contains("D.run"), "{out}");
+    let out = callers("D.step");
+    assert!(out.contains(":21 D.run c:"), "{out}");
+    // M inherits without defining: P(M, N) and Q(N, M) both reach N's, never A's.
+    let out = callers("N.step");
+    assert!(out.contains(":35 P.run c:") && out.contains(":40 Q.run c:"), "{out}");
+    assert!(!callers("A.step").contains("P.run") && !callers("A.step").contains("Q.run"), "{out}");
