+/// The Python files that hold classes around the changed ones (their subclasses and their
+/// bases, found by the base names written, so before the references are re-scored): the
+/// `self`/`super()` calls in them may reach another method now.
+fn python_hierarchy_files(tx: &Connection, pid: i64, paths: &HashSet<String>, names: &HashSet<String>) -> Result<HashSet<String>> {
+    const STEPS: usize = 8;
+    const MAX_CLASSES: usize = 4000;
+    let mut files: HashSet<String> = HashSet::new();
+    let mut subs_of = tx.prepare_cached(
+        "SELECT DISTINCT r.src, n.name, n.path FROM ts_ref r JOIN node n ON n.id = r.src
+         WHERE r.project_id = ?1 AND r.kind = 'impl' AND r.name = ?2 AND r.src != 0",
+    )?;
+    // Down: classes naming a changed (or removed) name as a base, and theirs in turn.
+    let mut seen: HashSet<i64> = HashSet::new();
+    let mut frontier: Vec<String> = names.iter().cloned().collect();
+    frontier.sort();
+    for _ in 0..STEPS {
+        let mut next = vec![];
+        for n in frontier {
+            let rows: Vec<(i64, String, String)> =
+                subs_of.query_map(params![pid, n], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)))?.flatten().collect();
+            for (id, name, path) in rows {
+                if seen.insert(id) && seen.len() <= MAX_CLASSES {
+                    files.insert(path);
+                    next.push(name);
+                }
+            }
+        }
+        frontier = next;
+    }
+    // Up: the bases the changed files name, and theirs: `super()` in them may reach the
+    // changed classes' methods in a diamond.
+    let mut by_path = tx.prepare_cached("SELECT DISTINCT name FROM ts_ref WHERE project_id = ?1 AND path = ?2 AND kind = 'impl'")?;
+    let mut class_named = tx.prepare_cached(
+        "SELECT id, path FROM node INDEXED BY node_sym_name WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter' AND name = ?2
+           AND json_extract(meta,'$.k') = 'class'",
+    )?;
+    let mut bases_of = tx.prepare_cached("SELECT DISTINCT name FROM ts_ref WHERE src = ?1 AND src != 0 AND kind = 'impl'")?;
+    let mut frontier: Vec<String> = vec![];
+    let mut sorted: Vec<&String> = paths.iter().collect();
+    sorted.sort();
+    for f in sorted {
+        frontier.extend(by_path.query_map(params![pid, f], |r| r.get::<_, String>(0))?.flatten());
+    }
+    let mut up_seen: HashSet<i64> = HashSet::new();
+    for _ in 0..STEPS {
+        let mut next = vec![];
+        for n in frontier {
+            let hits: Vec<(i64, String)> = class_named.query_map(params![pid, n], |r| Ok((r.get(0)?, r.get(1)?)))?.flatten().collect();
+            for (id, path) in hits {
+                if up_seen.insert(id) && up_seen.len() <= MAX_CLASSES {
+                    files.insert(path);
+                    next.extend(bases_of.query_map([id], |r| r.get::<_, String>(0))?.flatten());
+                }
+            }
+        }
+        frontier = next;
+    }
+    Ok(files)
+}
