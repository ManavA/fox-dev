+/// Python classes while the index resolves: base lists as just scored, with the store behind
+/// them for the rows a scoped run did not re-score.
+struct IndexClasses<'a> {
+    /// A scoped run: bases and subclasses outside this run's references come from the store.
+    tx: Option<&'a Connection>,
+    /// Base rows (`impl`) this run scored: rowid -> (class, base, ambiguity).
+    fresh: HashMap<i64, (i64, i64, i64)>,
+    /// The same by class (in source order) and by base.
+    fresh_bases: HashMap<i64, Vec<i64>>,
+    fresh_subs: HashMap<i64, Vec<i64>>,
+    cands: &'a HashMap<String, Vec<Cand>>,
+    /// name -> (class -> its definition), built when the name is first asked for.
+    defs: HashMap<String, HashMap<i64, i64>>,
+}
+
+impl crate::pymro::Classes for IndexClasses<'_> {
+    fn bases(&mut self, class: i64) -> Vec<i64> {
+        let Some(tx) = self.tx else {
+            return self.fresh_bases.get(&class).into_iter().flatten().map(|&id| id_of(&self.fresh, id)).collect();
+        };
+        let Ok(mut q) =
+            tx.prepare_cached("SELECT rowid, dst, amb FROM ts_ref WHERE src = ?1 AND src != 0 AND kind = 'impl' ORDER BY rowid")
+        else {
+            return vec![];
+        };
+        let rows: Vec<(i64, i64, i64)> =
+            q.query_map([class], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).map(|it| it.flatten().collect()).unwrap_or_default();
+        rows.into_iter()
+            .map(|(rowid, dst, amb)| match self.fresh.get(&rowid) {
+                Some(&(_, d, a)) => crate::pymro::base_of(rowid, d, a),
+                None => crate::pymro::base_of(rowid, dst, amb),
+            })
+            .collect()
+    }
+
+    fn subs(&mut self, class: i64) -> Vec<i64> {
+        let mut v: Vec<i64> = self.fresh_subs.get(&class).cloned().unwrap_or_default();
+        if let Some(tx) = self.tx
+            && let Ok(mut q) =
+                tx.prepare_cached("SELECT rowid, src FROM ts_ref WHERE dst = ?1 AND dst != 0 AND kind = 'impl' AND amb <= 0 AND src != 0")
+        {
+            let rows: Vec<(i64, i64)> =
+                q.query_map([class], |r| Ok((r.get(0)?, r.get(1)?))).map(|it| it.flatten().collect()).unwrap_or_default();
+            v.extend(rows.into_iter().filter(|(rowid, _)| !self.fresh.contains_key(rowid)).map(|x| x.1));
+        }
+        v.sort_unstable();
+        v.dedup();
+        v
+    }
+
+    fn def(&mut self, class: i64, name: &str) -> Option<i64> {
+        let cands = self.cands;
+        self.defs
+            .entry(name.to_string())
+            .or_insert_with(|| {
+                let mut m: HashMap<i64, i64> = HashMap::new();
+                for c in cands.get(name).into_iter().flatten() {
+                    if c.family == "python" && c.pid != 0 && (is_callable_kind(&c.kind) || is_type_kind(&c.kind)) {
+                        m.entry(c.pid).or_insert(c.id);
+                    }
+                }
+                m
+            })
+            .get(&class)
+            .copied()
+    }
+}
+
+/// The base a scored `impl` row stands for.
+fn id_of(fresh: &HashMap<i64, (i64, i64, i64)>, rowid: i64) -> i64 {
+    fresh.get(&rowid).map_or(-rowid, |&(_, d, a)| crate::pymro::base_of(rowid, d, a))
+}
+
+/// Python: a call (or a method passed as a value) through `self`, `cls` or `super()` reaches the
+/// definition the caller's class would run: the first class in its method resolution order that
+/// defines the name, for `super()` the next one after the caller's own class (and, in a diamond,
+/// the sibling branch's). Returns (reference index, target, ambiguity) for each reference the
+/// hierarchy answers; the rest keep their name-scored target.
+fn python_mro_targets(
+    tx: &Connection,
+    scoped: bool,
+    refs: &[RefRow],
+    scored: &[(i64, i64, i64)],
+    cands: &HashMap<String, Vec<Cand>>,
+    parent_of: &HashMap<i64, (i64, bool)>,
+) -> Result<Vec<(usize, i64, i64)>> {
+    let py = |path: &str| lang::for_path(path).is_some_and(|l| l.family == "python");
+    let asks = |r: &RefRow| {
+        r.recv && matches!(r.kind.as_str(), "call" | "ref") && matches!(r.via.as_deref(), Some("self" | "cls" | "super")) && py(&r.path)
+    };
+    let todo: Vec<usize> = (0..refs.len()).filter(|&i| asks(&refs[i])).collect();
+    if todo.is_empty() {
+        return Ok(vec![]);
+    }
+    let mut fresh: HashMap<i64, (i64, i64, i64)> = HashMap::new();
+    let mut fresh_bases: HashMap<i64, Vec<i64>> = HashMap::new();
+    let mut fresh_subs: HashMap<i64, Vec<i64>> = HashMap::new();
+    for (r, s) in refs.iter().zip(scored) {
+        if r.kind == "impl" && r.src != 0 && py(&r.path) {
+            fresh.insert(r.rowid, (r.src, s.0, s.1));
+            fresh_bases.entry(r.src).or_default().push(r.rowid);
+            if s.0 > 0 && s.1 <= 0 {
+                fresh_subs.entry(s.0).or_default().push(r.src);
+            }
+        }
+    }
+    for v in fresh_bases.values_mut() {
+        v.sort_unstable();
+    }
+    let mut mro =
+        crate::pymro::Mro::new(IndexClasses { tx: scoped.then_some(tx), fresh, fresh_bases, fresh_subs, cands, defs: HashMap::new() });
+    let mut out = vec![];
+    for i in todo {
+        let r = &refs[i];
+        // The class whose method the reference is in (through nested functions).
+        if !parent_of.get(&r.src).is_some_and(|p| p.1) {
+            continue;
+        }
+        let Some(class) = r.enclosing.iter().skip(1).copied().find(|id| parent_of.get(id).is_some_and(|p| !p.1)) else { continue };
+        let found = if r.via.as_deref() == Some("super") { mro.resolve_super(class, &r.name) } else { mro.resolve_self(class, &r.name) };
+        let Some(&t) = found.targets.first() else { continue };
+        let amb = if found.targets.len() > 1 { found.targets.len() as i64 } else { found.unsure as i64 };
+        out.push((i, t, amb));
+    }
+    Ok(out)
+}
