index 0000000..df45459
--- /dev/null
+++ b/src/pymro.rs
@@ -0,0 +1,226 @@
+//! Python's method resolution order over a project's classes: which definition a call through
+//! `self`, `cls` or `super()` reaches. The class graph comes from the caller (the index while it
+//! resolves, the store when an answer is built), so one linearization serves both.
+
+use std::collections::{HashMap, HashSet, VecDeque};
+
+/// What the linearization asks of a project's classes. Class ids are positive; a base that is
+/// not a project class (a library class, an unresolved name) is a negative placeholder that
+/// defines nothing.
+pub(crate) trait Classes {
+    /// The direct bases of `class`, in declaration order.
+    fn bases(&mut self, class: i64) -> Vec<i64>;
+    /// The classes naming `class` as a direct base.
+    fn subs(&mut self, class: i64) -> Vec<i64>;
+    /// The method (or nested class) `name` defined directly in `class`.
+    fn def(&mut self, class: i64, name: &str) -> Option<i64>;
+}
+
+/// The base an `impl` row stands for: its class when resolved with certainty, else a placeholder
+/// unique to the row.
+pub(crate) fn base_of(rowid: i64, dst: i64, amb: i64) -> i64 {
+    if dst > 0 && amb <= 0 { dst } else { -rowid }
+}
+
+/// Deepest chain of bases followed.
+const MAX_DEPTH: usize = 64;
+/// Most subclasses `super()` looks through for a sibling branch of a diamond.
+const MAX_SUBS: usize = 400;
+
+/// What a lookup found: the targets, the first one the certain answer when alone, and whether a
+/// base that is not a project class stood before it (the library's own method may run instead).
+#[derive(Debug, Default, PartialEq, Eq)]
+pub(crate) struct Found {
+    pub targets: Vec<i64>,
+    pub unsure: bool,
+}
+
+pub(crate) struct Mro<C: Classes> {
+    classes: C,
+    memo: HashMap<i64, Vec<i64>>,
+    /// A cycle or the depth cap cut the walk in progress short.
+    cut: bool,
+}
+
+impl<C: Classes> Mro<C> {
+    pub fn new(classes: C) -> Self {
+        Mro { classes, memo: HashMap::new(), cut: false }
+    }
+
+    /// `class` and its ancestors, C3 order. A hierarchy Python would reject keeps the order of
+    /// the bases as written, so a lookup still answers.
+    pub fn linearize(&mut self, class: i64) -> Vec<i64> {
+        self.lin(class, &mut vec![])
+    }
+
+    fn lin(&mut self, class: i64, stack: &mut Vec<i64>) -> Vec<i64> {
+        if let Some(m) = self.memo.get(&class) {
+            return m.clone();
+        }
+        if class < 0 || stack.contains(&class) || stack.len() >= MAX_DEPTH {
+            self.cut |= class >= 0;
+            return vec![class];
+        }
+        let outer = std::mem::replace(&mut self.cut, false);
+        stack.push(class);
+        let bases = self.classes.bases(class);
+        let mut seqs: Vec<VecDeque<i64>> = bases.iter().map(|&b| self.lin(b, stack).into()).collect();
+        stack.pop();
+        seqs.push(bases.iter().copied().collect());
+        let mut out = vec![class];
+        loop {
+            seqs.retain(|s| !s.is_empty());
+            if seqs.is_empty() {
+                break;
+            }
+            // The first head no other sequence still holds in its tail; none: take the first.
+            let head = seqs.iter().map(|s| s[0]).find(|h| seqs.iter().all(|s| !s.iter().skip(1).any(|x| x == h))).unwrap_or(seqs[0][0]);
+            out.push(head);
+            // Held in a tail only when the hierarchy has no C3 order: dropped there too.
+            for s in seqs.iter_mut() {
+                s.retain(|x| *x != head);
+            }
+        }
+        // A walk a cycle cut short is not cached: the answer depends on where it started.
+        if !self.cut {
+            self.memo.insert(class, out.clone());
+        }
+        self.cut |= outer;
+        out
+    }
+
+    /// The first definition of `name` along `order`, and whether a placeholder stood before it.
+    fn first(&mut self, order: &[i64], name: &str) -> Option<(i64, bool)> {
+        let mut unsure = false;
+        for &k in order {
+            if k < 0 {
+                unsure = true;
+            } else if let Some(t) = self.classes.def(k, name) {
+                return Some((t, unsure));
+            }
+        }
+        None
+    }
+
+    /// `self.name` / `cls.name` inside a method of `class`: the first class of its linearization
+    /// that defines `name`.
+    pub fn resolve_self(&mut self, class: i64, name: &str) -> Found {
+        let order = self.linearize(class);
+        match self.first(&order, name) {
+            Some((t, unsure)) => Found { targets: vec![t], unsure },
+            None => Found::default(),
+        }
+    }
+
+    /// `super().name` inside a method of `class`: the next definition after `class` in its own
+    /// linearization, and in that of every subclass (the instance may be one: in a diamond
+    /// `super()` of one branch reaches the other), the caller's own first.
+    pub fn resolve_super(&mut self, class: i64, name: &str) -> Found {
+        let mut found = Found::default();
+        let order = self.linearize(class);
+        if let Some((t, unsure)) = self.first(&order[1..], name) {
+            found.targets.push(t);
+            found.unsure |= unsure;
+        }
+        let mut seen: HashSet<i64> = HashSet::from([class]);
+        let mut queue: VecDeque<i64> = VecDeque::from([class]);
+        while let Some(x) = queue.pop_front() {
+            for d in self.classes.subs(x) {
+                if !seen.insert(d) || seen.len() > MAX_SUBS {
+                    continue;
+                }
+                queue.push_back(d);
+                let order = self.linearize(d);
+                let Some(at) = order.iter().position(|&k| k == class) else { continue };
+                if let Some((t, unsure)) = self.first(&order[at + 1..], name)
+                    && !found.targets.contains(&t)
+                {
+                    found.targets.push(t);
+                    found.unsure |= unsure;
+                }
+            }
+        }
+        found
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[derive(Default)]
+    struct G {
+        bases: HashMap<i64, Vec<i64>>,
+        defs: HashSet<(i64, &'static str)>,
+    }
+
+    impl Classes for G {
+        fn bases(&mut self, c: i64) -> Vec<i64> {
+            self.bases.get(&c).cloned().unwrap_or_default()
+        }
+        fn subs(&mut self, c: i64) -> Vec<i64> {
+            let mut v: Vec<i64> = self.bases.iter().filter(|(_, b)| b.contains(&c)).map(|(k, _)| *k).collect();
+            v.sort();
+            v
+        }
+        fn def(&mut self, c: i64, name: &str) -> Option<i64> {
+            self.defs.iter().find(|(k, n)| *k == c && *n == name).map(|(k, _)| k * 100)
+        }
+    }
+
+    // A=1, B=2(A), C=3(A), D=4(B, C)
+    fn diamond() -> G {
+        let mut g = G::default();
+        g.bases.insert(2, vec![1]);
+        g.bases.insert(3, vec![1]);
+        g.bases.insert(4, vec![2, 3]);
+        g
+    }
+
+    #[test]
+    fn c3_linearizes_a_diamond() {
+        let mut m = Mro::new(diamond());
+        assert_eq!(m.linearize(4), vec![4, 2, 3, 1]);
+        assert_eq!(m.linearize(2), vec![2, 1]);
+    }
+
+    #[test]
+    fn self_takes_the_first_definer_and_super_the_next() {
+        let mut g = diamond();
+        g.defs.extend([(1, "step"), (3, "step")]);
+        let mut m = Mro::new(g);
+        // D has no `step`: C's, not A's.
+        assert_eq!(m.resolve_self(4, "step").targets, vec![300]);
+        // `super()` in B: A alone, but C under D.
+        assert_eq!(m.resolve_super(2, "step").targets, vec![100, 300]);
+        // `super()` in C: A.
+        assert_eq!(m.resolve_super(3, "step").targets, vec![100]);
+    }
+
+    #[test]
+    fn an_inconsistent_hierarchy_and_a_cycle_still_answer() {
+        let mut g = G::default();
+        // X(A, B), Y(B, A), Z(X, Y): no C3 order.
+        g.bases.insert(10, vec![1, 2]);
+        g.bases.insert(11, vec![2, 1]);
+        g.bases.insert(12, vec![10, 11]);
+        let mut m = Mro::new(g);
+        let o = m.linearize(12);
+        assert_eq!(o.len(), 5, "{o:?}");
+        let mut g = G::default();
+        g.bases.insert(1, vec![2]);
+        g.bases.insert(2, vec![1]);
+        let mut m = Mro::new(g);
+        assert_eq!(m.linearize(1)[0], 1);
+    }
+
+    #[test]
+    fn a_library_base_before_the_definer_makes_it_unsure() {
+        let mut g = G::default();
+        // Child(lib, Mixin)
+        g.bases.insert(5, vec![-1, 6]);
+        g.defs.insert((6, "save"));
+        let mut m = Mro::new(g);
+        assert_eq!(m.resolve_self(5, "save"), Found { targets: vec![600], unsure: true });
+    }
+}
