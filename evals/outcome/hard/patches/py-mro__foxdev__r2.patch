+        ("h/mixin.py", "class Mixin:\n    def step(self):\n        pass\n"),
+        ("h/mid.py", "from h.base import Base\n\n\nclass Mid(Base):\n    pass\n"),
+        ("h/leaf.py", "from h.mid import Mid\n\n\nclass Leaf(Mid):\n    def run(self):\n        return self.step()\n"),
+    ]);
+    let callers = |sym: &str| resolved(&fox_code(&p, sym, "callers", 2000));
