+        let mut cur = src;
+        let mut class = 0;
+        for _ in 0..8 {
+            let Ok((p, _)) = up.query_row([cur], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, Option<String>>(1)?))) else { break };
+            if p == 0 {
+                break;
+            }
+            let pk: Option<String> = up.query_row([p], |r| r.get::<_, Option<String>>(1)).ok().flatten();
+            if pk.as_deref().is_some_and(is_callable_kind) {
+                cur = p;
+            } else {
+                class = p;
+                break;
+            }
+        }
+        if class == 0 {
+            continue;
+        }
+        let hit = *by_class.entry(class).or_insert_with(|| mro.resolve_super(class, &top.name).targets.contains(&top.id));
+        if hit {
+            out.push(rowid);
+        }
+    }
+    Ok(out)
+}
+
+/// The class hierarchy as the store holds it, for [`super_sites`].
+struct StoreClasses<'a> {
+    c: &'a Connection,
+    /// class -> its definition of the name asked about.
+    defs: HashMap<i64, i64>,
+}
+
+impl crate::pymro::Classes for StoreClasses<'_> {
+    fn bases(&mut self, class: i64) -> Vec<i64> {
+        let Ok(mut q) =
+            self.c.prepare_cached("SELECT rowid, dst, amb FROM ts_ref WHERE src = ?1 AND src != 0 AND kind = 'impl' ORDER BY rowid")
+        else {
+            return vec![];
+        };
+        q.query_map([class], |r| Ok(crate::pymro::base_of(r.get(0)?, r.get(1)?, r.get(2)?)))
+            .map(|it| it.flatten().collect())
+            .unwrap_or_default()
+    }
+
+    fn subs(&mut self, class: i64) -> Vec<i64> {
+        let Ok(mut q) = self
+            .c
+            .prepare_cached("SELECT DISTINCT src FROM ts_ref WHERE dst = ?1 AND dst != 0 AND kind = 'impl' AND amb <= 0 AND src != 0")
+        else {
+            return vec![];
+        };
+        let mut v: Vec<i64> = q.query_map([class], |r| r.get(0)).map(|it| it.flatten().collect()).unwrap_or_default();
+        v.sort_unstable();
+        v
+    }
+
+    fn def(&mut self, class: i64, _name: &str) -> Option<i64> {
+        self.defs.get(&class).copied()
+    }
+}
