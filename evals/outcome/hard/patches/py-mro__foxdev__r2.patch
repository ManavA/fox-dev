+/// Python calls through `self`, `cls` and `super()` follow the method resolution order (C3):
+/// the first class in the caller's linearization that defines the method, not any same-name
+/// method of a base. A subclass that overrides ends the walk, and in a diamond `super()` in one
+/// branch reaches the sibling branch.
+#[test]
+fn python_callers_follow_the_method_resolution_order() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("mro/__init__.py", ""),
+        ("mro/base.py", "class Base:\n    def step(self):\n        return 'base'\n"),
+        ("mro/mixin.py", "class Mixin:\n    def step(self):\n        return 'mixin'\n"),
+        (
+            "mro/child.py",
+            "from mro.mixin import Mixin\nfrom mro.base import Base\n\n\nclass Child(Mixin, Base):\n    def run(self):\n        return self.step()\n\n\nclass Leaf(Child):\n    def step(self):\n        return super().step()\n\n    def go(self):\n        return self.step()\n\n    @classmethod\n    def make(cls):\n        return cls.step(None)\n",
+        ),
+        // The mixin comes second: the base wins.
+        (
+            "mro/other.py",
+            "from mro.base import Base\nfrom mro.mixin import Mixin\n\n\nclass Other(Base, Mixin):\n    def run(self):\n        return self.step()\n",
+        ),
+        // A diamond: D -> B -> C -> A.
+        (
+            "mro/diamond.py",
+            "class A:\n    def step(self):\n        pass\n\n\nclass B(A):\n    def step(self):\n        super().step()\n\n\nclass C(A):\n    def step(self):\n        super().step()\n\n\nclass D(B, C):\n    def step(self):\n        super().step()\n\n    def run(self):\n        self.step()\n\n\nclass M(A):\n    pass\n\n\nclass N(A):\n    def step(self):\n        pass\n\n\nclass P(M, N):\n    def run(self):\n        self.step()\n\n\nclass Q(N, M):\n    def run(self):\n        self.step()\n",
+        ),
+        // One file, the two-argument `super`.
+        (
+            "mro/single.py",
+            "class SBase:\n    def tick(self):\n        pass\n\n\nclass SMixin:\n    def tick(self):\n        pass\n\n\nclass SChild(SMixin, SBase):\n    def tick(self):\n        super(SChild, self).tick()\n\n    def run(self):\n        self.tick()\n",
+        ),
+    ]);
+    let callers = |sym: &str| resolved(&fox_code(&p, sym, "callers", 2000));
+    let out = callers("SMixin.tick");
+    assert!(out.contains(":13 SChild.tick c:") && !out.contains("SChild.run"), "{out}");
+    assert!(callers("SChild.tick").contains(":16 SChild.run c:"), "{}", callers("SChild.tick"));
+    assert!(callers("SBase.tick").contains("0 call sites"), "{}", callers("SBase.tick"));
+    // Child(Mixin, Base): `self.step()` runs Mixin's; Leaf's `super().step()` too.
+    let out = callers("Mixin.step");
+    assert!(out.contains(":7 Child.run c:") && out.contains(":12 Leaf.step c:"), "{out}");
+    assert!(!out.contains("other.py"), "{out}");
+    let out = callers("Base.step");
+    assert!(out.contains(":7 Other.run c:"), "{out}");
+    assert!(!out.contains("Child.run") && !out.contains("Leaf.step"), "{out}");
+    // Leaf overrides: `self.step()` and `cls.step()` inside it are its own.
+    let out = callers("Leaf.step");
