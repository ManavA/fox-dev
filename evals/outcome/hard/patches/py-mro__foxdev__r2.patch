+/// `D`, though `B`'s own linearization ends at `A`. Rowids of those references.
+fn super_sites(c: &Connection, pid: i64, top: &TSym) -> Result<Vec<i64>> {
+    if !is_callable_kind(&top.kind) || crate::lang::for_path(&top.path).is_none_or(|l| l.family != "python") {
+        return Ok(vec![]);
+    }
+    let own: i64 = c.query_row(&format!("SELECT {SYM_PID} FROM node n WHERE n.id = ?1"), [top.id], |r| r.get(0)).unwrap_or(0);
+    if own == 0 {
+        return Ok(vec![]);
+    }
+    let mut q = c.prepare_cached(
+        "SELECT rowid, src FROM ts_ref WHERE project_id = ?1 AND name = ?2 AND via = 'super' AND recv != 0 AND kind IN ('call', 'ref')
+           AND src != 0 AND dst != 0 AND dst != ?3 LIMIT 5000",
+    )?;
+    let rows: Vec<(i64, i64)> =
+        q.query_map(params![pid, top.name, top.id], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)))?.flatten().collect();
+    if rows.is_empty() {
+        return Ok(vec![]);
+    }
+    let mut defs: HashMap<i64, i64> = HashMap::new();
+    let mut same = c.prepare_cached(&format!(
+        "SELECT {COLS}, {SYM_PID} FROM node n INDEXED BY node_sym_name
+         WHERE n.project_id = ?1 AND n.kind = 'symbol' AND n.source = 'treesitter' AND n.name = ?2 COLLATE NOCASE
+           AND COALESCE(json_extract(n.meta,'$.k'), '') != 'field'
+         ORDER BY n.id LIMIT {DISPATCH_SAME_MAX}"
+    ))?;
+    for (s, spid) in same.query_map(params![pid, top.name], |r| Ok((map(r)?, r.get::<_, i64>(7)?)))?.flatten() {
+        let py = crate::lang::for_path(&s.path).is_some_and(|l| l.family == "python");
+        if py && spid != 0 && s.name == top.name && (is_callable_kind(&s.kind) || is_type_kind(&s.kind)) {
+            defs.entry(spid).or_insert(s.id);
+        }
+    }
+    let mut mro = crate::pymro::Mro::new(StoreClasses { c, defs });
+    let mut up = c.prepare_cached("SELECT COALESCE(json_extract(meta,'$.pid'), 0), json_extract(meta,'$.k') FROM node WHERE id = ?1")?;
+    let mut by_class: HashMap<i64, bool> = HashMap::new();
+    let mut out = vec![];
+    for (rowid, src) in rows {
