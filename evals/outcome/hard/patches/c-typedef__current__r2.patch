+    tsindex::index_project(&mut c, &p).unwrap();
+    drop(c);
+    assert_eq!(c_member_kind("stop"), "method");
+    let out = fox_code(&p, "impl_run", "impact", 4000);
+    assert!(out.contains("use_run") && out.contains("via ops.run"), "{out}");
+}
