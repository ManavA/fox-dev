+/// What a typedef name stands for, as far as function-pointer members care.
+enum Typedef {
+    /// A function pointer (`typedef int (*op_fn)(int);`).
+    FnPtr,
+    /// Another typedef (`typedef op_fn op2_fn;`).
+    Alias(String),
+    Other,
+}
+
+/// C/C++: a member declared with a typedef'd type (`op_fn run;`) is a function-pointer member,
+/// a method of its struct like `int (*run)(int)`, when that typedef is a function pointer or a
+/// chain of typedefs ending in one; one whose typedef is not (or no longer) is a plain field.
+/// The typedef may be in any file, so this runs over the project after the files are stored.
+/// Returns the (name, container) of each member that changed.
+fn promote_typedef_members(tx: &Connection, pid: i64) -> Result<Vec<(String, String)>> {
+    let mut q = tx.prepare_cached(
+        "SELECT id, name, json_extract(meta,'$.k'), json_extract(meta,'$.fp'), json_extract(meta,'$.tm'), json_extract(meta,'$.f'),
+                COALESCE(json_extract(meta,'$.t'),''), COALESCE(json_extract(meta,'$.parent'),'')
+         FROM node WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter' AND lang IN ('c', 'cpp')
+           AND (json_extract(meta,'$.tm') IS NOT NULL OR json_extract(meta,'$.k') = 'type')",
+    )?;
+    let mut typedefs: HashMap<String, Vec<Typedef>> = HashMap::new();
+    // (id, name, container, typedef name, is a function member now)
+    let mut members: Vec<(i64, String, String, String, bool)> = vec![];
+    for row in q
+        .query_map([pid], |r| {
+            Ok((
+                r.get::<_, i64>(0)?,
+                r.get::<_, String>(1)?,
+                r.get::<_, Option<String>>(2)?,
+                r.get::<_, Option<i64>>(3)?,
+                r.get::<_, Option<i64>>(4)?,
+                r.get::<_, Option<i64>>(5)?,
+                r.get::<_, String>(6)?,
+                r.get::<_, String>(7)?,
+            ))
+        })?
+        .flatten()
+    {
+        let (id, name, k, fp, tm, f, t, parent) = row;
+        if tm.is_some() {
+            if let Some(td) = t.strip_prefix("T:") {
+                members.push((id, name, parent, td.to_string(), f.is_some()));
+            }
+        } else if k.as_deref() == Some("type") {
+            let kind = match t.strip_prefix("T:") {
+                _ if fp.is_some() => Typedef::FnPtr,
+                Some(to) => Typedef::Alias(to.to_string()),
+                None => Typedef::Other,
+            };
+            typedefs.entry(name).or_default().push(kind);
+        }
+    }
+    if members.is_empty() {
+        return Ok(vec![]);
+    }
+    // Does every definition of the name stand for a function pointer, directly or through a
+    // chain of typedefs (the steps of [`CTypes::aliases`])? A name defined two ways is unknown.
+    let is_fn = |name: &str| -> bool {
+        let mut cur = name;
+        for _ in 0..=C_ALIAS_STEPS {
+            let Some(defs) = typedefs.get(cur) else { return false };
+            if defs.iter().all(|d| matches!(d, Typedef::FnPtr)) {
+                return true;
+            }
+            let mut to: Option<&str> = None;
+            for d in defs {
+                match d {
+                    Typedef::Alias(t) if to.is_none_or(|x| x == t) => to = Some(t),
+                    _ => return false,
+                }
+            }
+            match to {
+                Some(t) => cur = t,
+                None => return false,
+            }
+        }
+        false
+    };
+    let mut up = tx.prepare_cached("UPDATE node SET meta = json_set(meta, '$.k', 'method', '$.f', 1) WHERE id = ?1")?;
+    let mut down = tx.prepare_cached("UPDATE node SET meta = json_remove(json_set(meta, '$.k', 'field'), '$.f') WHERE id = ?1")?;
+    let mut changed = vec![];
+    for (id, name, parent, td, now) in members {
+        let want = is_fn(&td);
+        if want != now {
+            if want { &mut up } else { &mut down }.execute([id])?;
+            changed.push((name, parent.rsplit('.').next().unwrap_or("").to_string()));
+        }
+    }
+    Ok(changed)
 }
 
