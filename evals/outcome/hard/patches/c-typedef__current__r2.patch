+/// A member declared with a typedef of a function pointer (`op_fn run;`), or a typedef of that
+/// typedef, is a function-pointer member like `int (*run)(int)`: calls through it reach it, and
+/// functions stored in it are dispatch targets. A plain data field with a typedef type, or a
+/// pointer or array of the typedef, stays a field.
+#[test]
+fn c_typedef_function_pointer_members_behave_like_plain_ones() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = c_ops_typedef_project();
+    for (name, kind) in [("run", "method"), ("stop", "method"), ("n", "field"), ("table", "field"), ("slots", "field")] {
+        assert_eq!(c_member_kind(name), kind, "{name}");
+    }
+    let out = fox_code(&p, "ops.run", "callers", 4000);
+    let r = resolved(&out);
+    assert!(r.contains("1 call sites in 1 files") && r.contains("use.c (1)") && !r.contains("guess"), "{out}");
+    let out = fox_code(&p, "ops.stop", "callers", 4000);
+    assert!(resolved(&out).contains("1 call sites in 1 files") && out.contains("use_stop"), "{out}");
+    let head = out.lines().next().unwrap_or("");
+    assert!(head.contains("1 line stores a function in it (not a call)"), "{out}");
+    let out = fox_code(&p, "impl_run", "impact", 4000);
+    assert!(out.contains("use_run") && out.contains("top") && out.contains("via ops.run"), "{out}");
+    let out = fox_code(&p, "impl_stop", "impact", 4000);
+    assert!(out.contains("use_stop") && out.contains("via ops.stop"), "{out}");
+    let out = fox_code(&p, "ops.run", "impact", 4000);
+    assert!(out.contains("impl_run") && out.contains("implements ops.run"), "{out}");
