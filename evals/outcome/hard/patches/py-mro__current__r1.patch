+/// Most subclasses of one class read when `super()` is followed through them.
+const PY_SUBS_MAX: usize = 200;
+
+/// The Python class hierarchy as method resolution reads it: each class's resolved bases in
+/// source order, its subclasses, and its C3 linearization. The bases come from the `impl` rows
+/// of the store, except those being re-scored (`fresh`: row -> (class, base)).
+struct PyHier<'a> {
+    tx: &'a Connection,
+    fresh: HashMap<i64, (i64, i64)>,
+    bases: HashMap<i64, Vec<i64>>,
+    subs: HashMap<i64, Vec<i64>>,
+    mros: HashMap<i64, Vec<i64>>,
+}
+
+impl<'a> PyHier<'a> {
+    fn new(tx: &'a Connection, fresh: HashMap<i64, (i64, i64)>) -> Self {
+        PyHier { tx, fresh, bases: HashMap::new(), subs: HashMap::new(), mros: HashMap::new() }
+    }
+
+    /// The resolved base classes of `c`, in the order the class statement names them.
+    fn bases(&mut self, c: i64) -> Result<Vec<i64>> {
+        if let Some(b) = self.bases.get(&c) {
+            return Ok(b.clone());
+        }
+        let mut q = self.tx.prepare_cached("SELECT rowid, dst FROM ts_ref WHERE src = ?1 AND kind = 'impl' ORDER BY rowid")?;
+        let mut v: Vec<i64> = vec![];
+        for (row, dst) in q.query_map([c], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)))?.flatten() {
+            let dst = self.fresh.get(&row).map_or(dst, |f| f.1);
+            if dst != 0 && dst != c && !v.contains(&dst) {
+                v.push(dst);
+            }
+        }
+        self.bases.insert(c, v.clone());
+        Ok(v)
+    }
+
+    /// The classes naming `c` as a base (at most [`PY_SUBS_MAX`]), by id.
+    fn subs(&mut self, c: i64) -> Result<Vec<i64>> {
+        if let Some(s) = self.subs.get(&c) {
+            return Ok(s.clone());
+        }
+        let mut q = self.tx.prepare_cached("SELECT rowid, src FROM ts_ref WHERE dst = ?1 AND kind = 'impl' AND src != 0 LIMIT ?2")?;
+        let mut v: Vec<i64> = vec![];
+        for (row, src) in q.query_map(params![c, PY_SUBS_MAX as i64 * 2], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)))?.flatten() {
+            if !self.fresh.contains_key(&row) {
+                v.push(src);
+            }
+        }
+        v.extend(self.fresh.values().filter(|f| f.1 == c).map(|f| f.0));
+        v.retain(|&s| s != c);
+        v.sort_unstable();
+        v.dedup();
+        v.truncate(PY_SUBS_MAX);
+        self.subs.insert(c, v.clone());
+        Ok(v)
+    }
+
+    /// C3 linearization of `c`; None when the hierarchy is inconsistent (Python refuses it).
+    fn lin(&mut self, c: i64, path: &mut Vec<i64>) -> Result<Option<Vec<i64>>> {
+        if let Some(m) = self.mros.get(&c) {
+            return Ok(Some(m.clone()));
+        }
+        if path.contains(&c) || path.len() > 64 {
+            return Ok(None);
+        }
+        path.push(c);
+        let direct = self.bases(c)?;
+        let mut seqs: Vec<Vec<i64>> = vec![];
+        for b in &direct {
+            match self.lin(*b, path)? {
+                Some(m) => seqs.push(m),
+                None => {
+                    path.pop();
+                    return Ok(None);
+                }
+            }
+        }
+        path.pop();
+        seqs.push(direct);
+        let mut out = vec![c];
+        loop {
+            seqs.retain(|s| !s.is_empty());
+            if seqs.is_empty() {
+                break;
+            }
+            let Some(h) = seqs.iter().map(|s| s[0]).find(|h| seqs.iter().all(|s| !s[1..].contains(h))) else { return Ok(None) };
+            out.push(h);
+            for s in seqs.iter_mut().filter(|s| s[0] == h) {
+                s.remove(0);
+            }
+        }
+        self.mros.insert(c, out.clone());
+        Ok(Some(out))
+    }
+
+    /// The classes Python searches for an attribute of an instance of `c`, in order: C3, or
+    /// depth-first left to right for a hierarchy it would reject.
+    fn mro(&mut self, c: i64) -> Result<Vec<i64>> {
+        if let Some(m) = self.lin(c, &mut vec![])? {
+            return Ok(m);
+        }
+        let mut out: Vec<i64> = vec![];
+        let mut stack = vec![c];
+        while let Some(x) = stack.pop() {
+            if out.contains(&x) || out.len() > 256 {
+                continue;
+            }
+            out.push(x);
+            stack.extend(self.bases(x)?.into_iter().rev());
+        }
+        self.mros.insert(c, out.clone());
+        Ok(out)
+    }
+
+    /// The method a call through `self`/`cls` in class `class` runs (`up`: through `super()`,
+    /// which starts after the class), among `defs` (class id -> its method of the name), and
+    /// how many methods it may reach. `super()` also reaches what the subclasses' own orders
+    /// put after `class` (a mixin's `super().step()` runs the next base of the class mixing it
+    /// in), so a target found only that way, or several, is a guess.
+    fn pick(&mut self, class: i64, up: bool, defs: &HashMap<i64, i64>) -> Result<Option<(i64, i64)>> {
+        let own = self.mro(class)?;
+        let first = own.iter().skip(up as usize).find_map(|k| defs.get(k)).copied();
+        if !up {
+            return Ok(first.map(|t| (t, 0)));
+        }
+        let mut targets: Vec<i64> = first.into_iter().collect();
+        let mut seen: HashSet<i64> = HashSet::from([class]);
+        let mut todo = vec![class];
+        while let Some(x) = todo.pop() {
+            for k in self.subs(x)? {
+                if !seen.insert(k) || seen.len() > PY_SUBS_MAX {
+                    continue;
+                }
+                todo.push(k);
+                let m = self.mro(k)?;
+                if let Some(at) = m.iter().position(|&y| y == class)
+                    && let Some(t) = m[at + 1..].iter().find_map(|y| defs.get(y)).copied()
+                    && !targets.contains(&t)
+                {
+                    targets.push(t);
+                }
+            }
+        }
+        Ok(match targets.as_slice() {
+            [] => None,
+            [t] => Some((*t, first.is_none() as i64)),
+            [t, ..] => Some((*t, targets.len() as i64)),
+        })
+    }
+}
