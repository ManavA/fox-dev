+/// Targets of the Python calls through `self`, `cls` and `super()` that the method resolution
+/// order of the calling class settles: reference index -> (method, ambiguity).
+fn python_mro_picks(
+    tx: &Connection,
+    refs: &[RefRow],
+    cands: &HashMap<String, Vec<Cand>>,
+    type_ids: &HashSet<i64>,
+    imports: &HashMap<String, FileImports>,
+) -> Result<HashMap<usize, (i64, i64)>> {
+    let is_py: &dyn Fn(&str) -> bool = &|p| lang::for_path(p).is_some_and(|l| l.family == "python");
+    let wanted: Vec<usize> = refs
+        .iter()
+        .enumerate()
+        .filter(|(_, r)| {
+            r.recv
+                && matches!(r.kind.as_str(), "call" | "ref")
+                && r.via.as_deref().is_some_and(|v| SELF_NAMES.contains(&v))
+                && is_py(&r.path)
+        })
+        .map(|x| x.0)
+        .collect();
+    let mut picks = HashMap::new();
+    if wanted.is_empty() {
+        return Ok(picks);
+    }
+    // The base classes named in the files being re-scored, resolved as the scoring will.
+    let mut fresh: HashMap<i64, (i64, i64)> = HashMap::new();
+    for r in refs.iter().filter(|r| r.kind == "impl" && r.src != 0 && is_py(&r.path)) {
+        let all = cands.get(&r.name).map(Vec::as_slice).unwrap_or(&[]);
+        let (dst, _) = score(r, all, imports.get(&r.path));
+        let is_type = all.iter().any(|c| c.id == dst && is_type_kind(&c.kind));
+        fresh.insert(r.rowid, (r.src, if is_type { dst } else { 0 }));
+    }
+    let mut hier = PyHier::new(tx, fresh);
+    let mut defs: HashMap<&str, HashMap<i64, i64>> = HashMap::new();
+    for &i in &wanted {
+        let r = &refs[i];
+        let Some(class) = r.enclosing.iter().copied().find(|id| type_ids.contains(id)) else { continue };
+        let by_class = defs.entry(r.name.as_str()).or_insert_with(|| {
+            let mut m = HashMap::new();
+            for s in cands.get(&r.name).into_iter().flatten().filter(|s| s.family == "python" && s.pid != 0 && is_callable_kind(&s.kind)) {
+                m.entry(s.pid).or_insert(s.id);
+            }
+            m
+        });
+        if by_class.is_empty() {
+            continue;
+        }
+        if let Some(t) = hier.pick(class, r.via.as_deref() == Some("super"), by_class)? {
+            picks.insert(i, t);
+        }
+    }
+    Ok(picks)
+}
