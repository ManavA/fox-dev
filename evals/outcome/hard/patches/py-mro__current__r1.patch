+/// Python calls through `self`, `cls` and `super()` in the subclasses of classes the scoped run
+/// touches: a class gaining or losing a base changes which method those calls run, though their
+/// own files and names are untouched. `refs` are the references already loaded to re-score.
+fn python_subclass_calls(tx: &Connection, pid: i64, paths: &HashSet<String>, refs: &[RefRow]) -> Result<Vec<RefRow>> {
+    let is_py = |p: &str| lang::for_path(p).is_some_and(|l| l.family == "python");
+    let mut seeds: Vec<i64> = refs.iter().filter(|r| r.kind == "impl" && r.src != 0 && is_py(&r.path)).map(|r| r.src).collect();
+    let mut classes = tx.prepare_cached(
+        "SELECT id FROM node WHERE project_id = ?1 AND path = ?2 AND kind = 'symbol' AND source = 'treesitter' AND json_extract(meta,'$.k') = 'class'",
+    )?;
+    for path in paths.iter().filter(|p| is_py(p)) {
+        seeds.extend(classes.query_map(params![pid, path], |r| r.get::<_, i64>(0))?.flatten());
+    }
+    if seeds.is_empty() {
+        return Ok(vec![]);
+    }
+    // The classes below them, by what the store resolved.
+    let mut below = tx.prepare_cached("SELECT src FROM ts_ref WHERE dst = ?1 AND kind = 'impl' AND src != 0")?;
+    let mut all: HashSet<i64> = seeds.iter().copied().collect();
+    let mut frontier = seeds;
+    while !frontier.is_empty() && all.len() < PY_SUBS_MAX * 25 {
+        let mut next = vec![];
+        for c in frontier {
+            for s in below.query_map([c], |r| r.get::<_, i64>(0))?.flatten() {
+                if all.insert(s) {
+                    next.push(s);
+                }
+            }
+        }
+        frontier = next;
+    }
+    let mut q = tx.prepare_cached(&format!(
+        "SELECT {REF_COLS} FROM ts_ref WHERE src IN (SELECT id FROM node WHERE kind = 'symbol' AND json_extract(meta,'$.pid') = ?1)
+           AND recv != 0 AND via IN ('self', 'cls', 'super') AND kind IN ('call', 'ref')"
+    ))?;
+    let mut out = vec![];
+    let mut ids: Vec<i64> = all.into_iter().collect();
+    ids.sort_unstable();
+    for c in ids {
+        out.extend(q.query_map([c], map_ref)?.flatten());
+    }
+    Ok(out)
+}
