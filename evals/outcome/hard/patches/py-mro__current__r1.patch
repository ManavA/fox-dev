+/// Python: changing a base class in one file re-resolves the `self.m()` calls of its subclasses
+/// in other files, which are not touched themselves.
+#[test]
+fn python_method_resolution_follows_a_base_changed_later() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, r, p) = inline_project(&[
+        ("inc/left.py", "class Left:\n    def step(self):\n        return 1\n"),
+        ("inc/right.py", "class Right:\n    def step(self):\n        return 2\n"),
+        ("inc/mid.py", "from inc.left import Left\n\n\nclass Mid(Left):\n    pass\n"),
+        ("inc/sub.py", "from inc.mid import Mid\n\n\nclass Sub(Mid):\n    def go(self):\n        return self.step()\n"),
+    ]);
+    let callers = |sym: &str| fox_code(&p, sym, "callers", 2000).contains("Sub.go c:");
+    assert!(callers("Left.step") && !callers("Right.step"));
+    std::fs::write(r.path().join("inc/mid.py"), "from inc.right import Right\n\n\nclass Mid(Right):\n    pass\n").unwrap();
+    let mut c = db::open_rw().unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    drop(c);
+    assert!(callers("Right.step") && !callers("Left.step"));
+}
