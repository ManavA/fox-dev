+/// Python: `self.m()` and `super().m()` reach the method Python would run, by the C3 method
+/// resolution order of the calling class: a mixin listed before the base wins, a diamond reads
+/// left to right with the shared base last, and a subclass override takes its own calls.
+#[test]
+fn python_calls_follow_the_method_resolution_order() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("mro/base.py", "class Base:\n    def step(self):\n        return 1\n\n    def run(self):\n        return self.step()\n"),
+        ("mro/mixin.py", "class Mixin:\n    def step(self):\n        return 2\n"),
+        (
+            "mro/child.py",
+            "from mro.base import Base\nfrom mro.mixin import Mixin\n\n\nclass Child(Mixin, Base):\n    def go(self):\n        return self.step()\n\n\nclass Over(Child):\n    def step(self):\n        return super().step()\n\n    def again(self):\n        return self.step()\n\n\nclass Grand(Over):\n    def deep(self):\n        return self.step()\n",
+        ),
+        (
+            "mro/diamond.py",
+            "class A:\n    def step(self):\n        return 1\n\n\nclass B(A):\n    def other(self):\n        return 2\n\n\nclass C(A):\n    def step(self):\n        return super().step()\n\n\nclass D(B, C):\n    def go(self):\n        return self.step()\n\n    def up(self):\n        return super().step()\n",
+        ),
+        (
+            "mro/coop.py",
+            "class Root:\n    def step(self):\n        return 1\n\n\nclass Mix:\n    def step(self):\n        return super().step()\n\n\nclass Both(Mix, Root):\n    def go(self):\n        return self.step()\n",
+        ),
+    ]);
+    let who = |sym: &str| {
+        let out = fox_code(&p, sym, "callers", 2000);
+        out.lines().filter_map(|l| l.trim().strip_prefix(':')).filter_map(|l| l.split(' ').nth(1)).map(str::to_string).collect::<Vec<_>>()
+    };
+    // Base.step is called only by its own `run`: not by Child.go (Mixin comes first), nor by
+    // the subclasses that reach Over.step or Mixin.step.
+    assert_eq!(who("Base.step"), ["Base.run"]);
+    let m = who("Mixin.step");
+    assert!(m.contains(&"Child.go".to_string()), "{m:?}");
+    assert!(m.contains(&"Over.step".to_string()), "super() skips Over, Child and lands on Mixin: {m:?}");
+    assert!(!m.contains(&"Over.again".to_string()) && !m.contains(&"Grand.deep".to_string()), "{m:?}");
+    let o = who("Over.step");
+    assert!(o.contains(&"Over.again".to_string()) && o.contains(&"Grand.deep".to_string()), "{o:?}");
+    // Diamond D(B, C): B has no step, so C's comes before A's.
+    assert_eq!(who("C.step"), ["D.go", "D.up"]);
+    assert_eq!(who("A.step"), ["C.step"]);
+    // A mixin's `super().step()` runs the next base of the class mixing it in.
+    assert_eq!(who("Mix.step"), ["Both.go"]);
+    assert_eq!(who("Root.step"), ["Mix.step"]);
+}
