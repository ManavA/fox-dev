+/// C++: the class a type node names, as `T:Name` (`P:Name` behind a smart pointer: only `->` goes
+/// through to it). C++ has one namespace for class, struct, union and typedef names, so `T:` is
+/// all there is. None for a primitive, a standard library type (`std::string`), `auto` or an
+/// anonymous struct.
+fn cpp_type(t: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    let text = |n: tree_sitter::Node| n.utf8_text(src).ok().filter(|s| !s.is_empty() && s.len() <= 120).map(str::to_string);
+    match t.kind() {
+        "type_identifier" => text(t).map(|n| format!("T:{n}")),
+        "struct_specifier" | "class_specifier" | "union_specifier" => text(t.child_by_field_name("name")?).map(|n| format!("T:{n}")),
+        "type_descriptor" => cpp_type(t.child_by_field_name("type")?, src),
+        "qualified_identifier" => {
+            // `ns::Engine`: its last name; anything under `std::` is the library's.
+            let mut first = t.child_by_field_name("scope");
+            while let Some(s) = first.filter(|s| s.kind() == "qualified_identifier") {
+                first = s.child_by_field_name("scope");
+            }
+            let name = t.child_by_field_name("name")?;
+            if first.and_then(text).is_some_and(|s| s == "std") {
+                // `std::unique_ptr<Pump>` is a Pump behind `->`; no other library type is ours.
+                return cpp_type(name, src).filter(|t| t.starts_with("P:"));
+            }
+            cpp_type(name, src)
+        }
+        "template_type" => {
+            let n = t.child_by_field_name("name")?;
+            let last = if n.kind() == "qualified_identifier" { n.child_by_field_name("name")? } else { n };
+            let name = text(last)?;
+            if SMART_TYPES.contains(&name.as_str()) {
+                let arg = t.child_by_field_name("arguments")?.named_child(0)?;
+                let inner = cpp_type(arg, src)?;
+                return Some(format!("P:{}", inner.strip_prefix("T:")?));
+            }
+            // `Wrapper<int>` is the class `Wrapper`, unless it is the library's.
+            if n.kind() == "qualified_identifier" { cpp_type(n, src) } else { Some(format!("T:{name}")) }
+        }
+        _ => None,
+    }
+}
+
+/// C++: the type a declaration's `type` field names (see [`cpp_type`]).
+fn cpp_type_name(decl: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    cpp_type(decl.child_by_field_name("type")?, src)
+}
+
+/// C++: the type of an expression that makes a value of a visible type: `Engine()` and `Engine{}`
+/// (`K:Engine`: a constructor, or a function of that name, settled when resolving), `new Pump`,
+/// `std::make_unique<Pump>()`, `static_cast<Engine *>(p)`.
+fn cpp_value_type(e: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    let text = |n: tree_sitter::Node| n.utf8_text(src).ok().filter(|s| !s.is_empty() && s.len() <= 120).map(str::to_string);
+    match e.kind() {
+        "parenthesized_expression" => cpp_value_type(e.named_child(0)?, src),
+        "new_expression" | "compound_literal_expression" => cpp_type_name(e, src),
+        "call_expression" => {
+            let mut f = e.child_by_field_name("function")?;
+            let mut std_scope = false;
+            if f.kind() == "qualified_identifier" {
+                let scope = f.child_by_field_name("scope").and_then(text);
+                std_scope = scope.as_deref() == Some("std");
+                f = f.child_by_field_name("name")?;
+            }
+            match f.kind() {
+                "identifier" if !std_scope => text(f).map(|n| format!("K:{n}")),
+                "template_function" => {
+                    let name = text(f.child_by_field_name("name")?)?;
+                    let arg = f.child_by_field_name("arguments")?.named_child(0).and_then(|a| cpp_type(a, src))?;
+                    if SMART_MAKERS.contains(&name.as_str()) {
+                        Some(format!("P:{}", arg.strip_prefix("T:")?))
+                    } else if CPP_CASTS.contains(&name.as_str()) {
+                        Some(arg)
+                    } else {
+                        None
+                    }
+                }
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+/// C++: the type of the variable a declaration (or a parameter, or a range `for`) declares: its
+/// written type, or for `auto` the type its initializer makes (see [`cpp_value_type`]).
+fn cpp_declared_type(d: tree_sitter::Node, anc: &[tree_sitter::Node], src: &[u8]) -> Option<String> {
+    if let Some(t) = cpp_type_name(d, src) {
+        return Some(t);
+    }
+    if d.kind() != "declaration" {
+        return None;
+    }
+    let init = anc.iter().rev().take_while(|a| a.id() != d.id()).find(|a| a.kind() == "init_declarator")?;
+    cpp_value_type(init.child_by_field_name("value")?, src)
+}
