+            }
+            let scope = q.child_by_field_name("scope")?;
+            match scope.kind() {
+                "namespace_identifier" => scope.utf8_text(src).ok().map(str::to_string),
+                "template_type" => name(scope.child_by_field_name("name")?),
+                _ => name(scope),
+            }
+        }
+        _ => None,
+    }
+}
