+/// Functions whose first template argument is the type of what they return.
+const CPP_MAKERS: &[&str] = &[
+    "make_unique",
+    "make_shared",
+    "make_optional",
+    "static_cast",
+    "dynamic_cast",
+    "reinterpret_cast",
