+/// Python class hierarchy for method resolution: base classes in source order (as stored and
+/// as freshly scored), and each class's C3 linearization.
+struct Mro<'a> {
+    tx: &'a Connection,
+    /// Fresh (target, ambiguity) of the `impl` references scored in this run, by rowid.
+    fresh: HashMap<i64, (i64, i64)>,
+    /// A node's kind (`meta.k`).
+    kinds: HashMap<i64, Option<String>>,
+    lin: HashMap<i64, Vec<i64>>,
+    open: HashSet<i64>,
+}
+
+impl Mro<'_> {
+    fn kind(&mut self, id: i64) -> Result<Option<String>> {
+        if let Some(k) = self.kinds.get(&id) {
+            return Ok(k.clone());
+        }
+        let k: Option<String> = self
+            .tx
+            .prepare_cached("SELECT json_extract(meta,'$.k') FROM node WHERE id = ?1 AND kind = 'symbol'")?
+            .query_row([id], |r| r.get(0))
+            .unwrap_or(None);
+        self.kinds.insert(id, k.clone());
+        Ok(k)
+    }
+
+    /// The project classes `k` names as bases, in order. A base that is not a project class
+    /// (`object`, a library's) or whose link is a guess is left out.
+    fn bases(&mut self, k: i64) -> Result<Vec<i64>> {
+        let rows: Vec<(i64, i64, i64)> = self
+            .tx
+            .prepare_cached("SELECT rowid, dst, amb FROM ts_ref WHERE src = ?1 AND src != 0 AND kind = 'impl' ORDER BY rowid")?
+            .query_map([k], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)))?
+            .flatten()
+            .collect();
+        let mut out = vec![];
+        for (rowid, dst, amb) in rows {
+            let (dst, amb) = self.fresh.get(&rowid).copied().unwrap_or((dst, amb));
+            if dst != 0 && amb <= 0 && dst != k && !out.contains(&dst) && self.kind(dst)?.as_deref() == Some("class") {
+                out.push(dst);
+            }
+        }
+        Ok(out)
+    }
+
+    /// Python's method resolution order of class `k` (C3; `k` first). A hierarchy C3 rejects
+    /// falls back to depth-first, left to right.
+    fn linearize(&mut self, k: i64) -> Result<Vec<i64>> {
+        if let Some(l) = self.lin.get(&k) {
+            return Ok(l.clone());
+        }
+        // A cycle (broken code): the class alone.
+        if !self.open.insert(k) {
+            return Ok(vec![k]);
+        }
+        let bases = self.bases(k)?;
+        let mut seqs: Vec<Vec<i64>> = vec![];
+        for b in &bases {
+            seqs.push(self.linearize(*b)?);
+        }
+        seqs.push(bases.clone());
+        self.open.remove(&k);
+        let mut out = vec![k];
+        loop {
+            seqs.retain(|s| !s.is_empty());
+            if seqs.is_empty() {
+                break;
+            }
+            let next = seqs.iter().map(|s| s[0]).find(|c| seqs.iter().all(|s| !s[1..].contains(c)));
+            let Some(c) = next else {
+                out = vec![k];
+                for b in &bases {
+                    for x in self.linearize(*b)? {
+                        if !out.contains(&x) {
+                            out.push(x);
+                        }
+                    }
+                }
+                break;
+            };
+            out.push(c);
+            for s in seqs.iter_mut() {
+                if s[0] == c {
+                    s.remove(0);
+                }
+            }
+        }
+        self.lin.insert(k, out.clone());
+        Ok(out)
+    }
+}
+
+/// Python: a call through `self`, `cls` or `super()` reaches the method Python would run: the
+/// first class of the calling class's method resolution order that defines it (`super()`: past
+/// the calling class itself). Replaces the name-based pick, which cannot tell the classes of a
+/// hierarchy apart. When no project class of the hierarchy defines the name, the name-based pick
+/// stands, except that `super().m()` never reaches a method of its own class.
+fn python_mro(tx: &Connection, refs: &[RefRow], cands: &HashMap<String, Vec<Cand>>, scored: &mut [(i64, i64, i64)]) -> Result<()> {
+    let todo: Vec<usize> = refs
+        .iter()
+        .enumerate()
+        .filter(|(_, r)| {
+            r.kind == "call"
+                && r.recv
+                && matches!(r.via.as_deref(), Some("self" | "cls" | "super"))
+                && lang::for_path(&r.path).is_some_and(|l| l.family == "python")
+        })
+        .map(|(i, _)| i)
+        .collect();
+    if todo.is_empty() {
+        return Ok(());
+    }
+    let fresh = refs.iter().zip(scored.iter()).filter(|(r, _)| r.kind == "impl").map(|(r, s)| (r.rowid, (s.0, s.1))).collect();
+    let mut m = Mro { tx, fresh, kinds: HashMap::new(), lin: HashMap::new(), open: HashSet::new() };
+    for i in todo {
+        let r = &refs[i];
+        // The nearest class around the call (a call in a function nested in a method too).
+        let mut class = None;
+        for &e in &r.enclosing {
+            if m.kind(e)?.as_deref() == Some("class") {
+                class = Some(e);
+                break;
+            }
+        }
+        let Some(class) = class else { continue };
+        let is_super = r.via.as_deref() == Some("super");
+        let line = m.linearize(class)?;
+        let all = cands.get(&r.name).map(Vec::as_slice).unwrap_or(&[]);
+        let found = line
+            .iter()
+            .skip(is_super as usize)
+            .find_map(|&k| all.iter().find(|s| s.pid == k && s.family == "python" && !s.local && is_callable_kind(&s.kind)));
+        match found {
+            Some(s) => scored[i] = (s.id, 0, scored[i].2),
+            None if is_super && all.iter().any(|s| s.id == scored[i].0 && s.pid == class) => scored[i] = (0, 0, scored[i].2),
+            None => {}
+        }
+    }
+    Ok(())
+}
