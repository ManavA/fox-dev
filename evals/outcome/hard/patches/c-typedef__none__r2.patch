+        "SELECT json_extract(meta,'$.td'), json_extract(meta,'$.t'), json_extract(meta,'$.tk') FROM node
+         WHERE project_id = ?1 AND name = ?2 AND kind = 'symbol' AND source = 'treesitter' AND json_extract(meta,'$.k') = 'type'",
+    )?;
+    // Pointers over a function that typedef `name` stands for: None when unknown or when its
+    // definitions disagree.
+    let mut depth = |name: &str| -> Option<i64> {
+        fn go(q: &mut rusqlite::Statement, pid: i64, name: &str, steps: usize) -> Option<i64> {
+            let rows: Vec<(Option<i64>, Option<String>, Option<i64>)> =
+                q.query_map(params![pid, name], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).ok()?.flatten().collect();
+            let mut vals: HashSet<i64> = HashSet::new();
+            for (td, t, tk) in rows {
+                if let Some(d) = td {
+                    vals.insert(d);
+                } else if steps > 0
+                    && let Some(base) = t.as_deref().and_then(|t| t.strip_prefix("T:"))
+                    && let Some(d) = go(q, pid, base, steps - 1)
