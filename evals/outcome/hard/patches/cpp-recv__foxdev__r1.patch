+/// Editing a C++ header moves the calls through a changed field type, and a class added later
+/// makes `auto x = Name()` a construction; the scoped update matches a full re-resolution.
+#[test]
+fn cpp_member_links_follow_header_edits() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = inline_project(&[
+        ("a.hpp", "struct A { void go(); };\nstruct B { void go(); };\nstruct Holder {\n  A part;\n};\n"),
+        ("use.cpp", "#include \"a.hpp\"\nvoid f(Holder& h) {\n  h.part.go();\n  auto x = Maker();\n  x.go();\n}\n"),
+    ]);
+    let a = fox_code(&p, "A.go", "callers", 4000);
+    let hit = a.lines().find(|l| l.contains("h.part.go()")).unwrap_or("");
+    assert!(!hit.is_empty() && !hit.contains("guess"), "{a}");
+    let mut c = db::open_rw().unwrap();
+    let h = repo.path().join("a.hpp");
+    let text = std::fs::read_to_string(&h).unwrap();
+    std::fs::write(&h, text.replace("A part;", "B part;")).unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    assert_eq!(tsindex::index_project(&mut c, &p).unwrap().parsed, 1);
+    let (a, b) = (fox_code(&p, "A.go", "callers", 4000), fox_code(&p, "B.go", "callers", 4000));
+    let line = |o: &str| o.lines().find(|l| l.contains("h.part.go()")).unwrap_or("").to_string();
+    assert!(line(&b).contains("h.part.go()") && !line(&b).contains("guess") && line(&a).is_empty(), "{a}\n{b}");
+    // `Maker` becomes a class: `x` is a `Maker`, which has no `go`, so the call stays a guess.
+    std::fs::write(&h, format!("{}struct Maker {{ int n; }};\n", std::fs::read_to_string(&h).unwrap())).unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    let snap = |c: &rusqlite::Connection| -> Vec<(i64, i64, i64)> {
+        let mut q = c.prepare("SELECT rowid, dst, amb FROM ts_ref ORDER BY rowid").unwrap();
+        q.query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).unwrap().flatten().collect()
+    };
+    let inc = snap(&c);
+    tsindex::resolve(&c, p.id).unwrap();
+    assert_eq!(snap(&c), inc);
