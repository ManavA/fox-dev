+            .and_then(|n| n.rsplit('.').next().map(str::to_string))
+            .filter(|c| !c.is_empty());
+        p.refs[i].rtype = match (base.strip_prefix("U:"), cls) {
+            (None, Some(c)) => Some(format!("T:{c}|{rest}")),
+            (None, None) => None,
+            (Some(name), Some(c)) => Some(format!("T:{c}|.{name}|{rest}")),
+            (Some(name), None) => Some(format!("V:{name}|{rest}")),
+        };
