+fn cpp_recv_project() -> (tempfile::TempDir, tempfile::TempDir, project::Project) {
+    inline_project(&[
+        (
+            "m.hpp",
+            "namespace m {\nstruct Engine {\n  void start();\n  void stop() {}\n};\nclass Pump {\n public:\n  void start();\n};\nstruct Rig {\n  Engine engine;\n  Pump* pump;\n};\nEngine make_engine();\nstd::unique_ptr<Pump> make_pump();\n}\n",
+        ),
+        (
+            "m.cpp",
+            "#include \"m.hpp\"\nnamespace m {\nvoid Engine::start() {}\nvoid Pump::start() {}\nEngine make_engine() { return Engine(); }\nstd::unique_ptr<Pump> make_pump() { return nullptr; }\n}\n",
+        ),
+        ("local.cpp", "#include \"m.hpp\"\nvoid a() {\n  m::Engine e;\n  e.start();\n}\n"),
+        ("pp.cpp", "#include \"m.hpp\"\nvoid b(m::Pump* p) {\n  p->start();\n}\nvoid c(const Pump& p) {\n  p.start();\n}\n"),
+        ("rig.cpp", "#include \"m.hpp\"\nvoid f(Rig& r, Rig* q) {\n  r.engine.start();\n  q->pump->start();\n}\n"),
+        (
+            "auto.cpp",
+            "#include \"m.hpp\"\nvoid g() {\n  auto e = Engine();\n  e.start();\n}\nvoid h() {\n  auto p = std::make_unique<Pump>();\n  p->start();\n}\n",
+        ),
+        ("ret.cpp", "#include \"m.hpp\"\nvoid i() {\n  auto e = make_engine();\n  e.start();\n  auto p = make_pump();\n  p->start();\n}\n"),
+        (
+            "car.cpp",
+            "#include \"m.hpp\"\nclass Car {\n  Engine engine_;\n  Pump* pump_;\n  void go() {\n    engine_.start();\n    this->pump_->start();\n  }\n};\n",
+        ),
+        ("sp.cpp", "#include \"m.hpp\"\nvoid j() {\n  std::shared_ptr<Pump> p;\n  p->start();\n  Engine e{};\n  e.stop();\n}\n"),
+        ("unk.cpp", "void u(Thing& t) {\n  t.start();\n}\nvoid v() {\n  auto x = lookup();\n  x.start();\n}\n"),
