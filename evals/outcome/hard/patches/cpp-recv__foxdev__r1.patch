+/// A receiver whose type cannot be told keeps the call a guess, and a smart pointer's own
+/// members (`p.reset()`) are never its pointee's.
+#[test]
+fn cpp_untyped_receivers_stay_guesses() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = cpp_recv_project();
+    let e = fox_code(&p, "Engine.start", "callers", 4000);
+    let pu = fox_code(&p, "Pump.start", "callers", 4000);
+    // The unknown receivers' calls are listed only as guesses, wherever they land.
+    let unk: Vec<&str> = e.lines().chain(pu.lines()).filter(|l| l.contains("t.start()") || l.contains("x.start()")).collect();
+    assert!(unk.iter().all(|l| l.contains("guess")) || unk.is_empty(), "{unk:?}\n{e}\n{pu}");
+    assert!(!resolved(&e).contains("unk.cpp") || e.contains("guess 1 of"), "{e}");
+    assert!(!resolved(&pu).contains("unk.cpp") || pu.contains("guess 1 of"), "{pu}");
+    let (_h2, _r2, q) = inline_project(&[
+        ("a.hpp", "struct Pump { void start(); void reset(); };\nstruct Other { void reset(); };\n"),
+        ("b.cpp", "void f() {\n  std::unique_ptr<Pump> p;\n  p.reset();\n  p->reset();\n  (*p).start();\n}\n"),
+    ]);
+    let out = fox_code(&q, "Pump.reset", "callers", 4000);
+    let r = resolved(&out);
+    assert!(r.contains("p->reset()") && !r.contains("p.reset()") && !out.contains("guess"), "{out}");
+    let out = fox_code(&q, "Pump.start", "callers", 4000);
+    assert!(out.contains("(*p).start()") && !out.contains("guess"), "{out}");
+}
