+/// A C++ member call through a receiver of plain declared or inferred type (a local, a
+/// parameter, a member of a typed struct, `auto` from a constructor, `make_unique` or a
+/// function's return type) reaches that class's method with certainty; an untyped receiver
+/// stays a guess.
+#[test]
+fn cpp_member_calls_resolve_through_the_receivers_type() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = cpp_recv_project();
+    let e = fox_code(&p, "Engine.start", "callers", 4000);
+    let r = resolved(&e);
+    for f in ["local.cpp (1)", "rig.cpp (1)", "auto.cpp (1)", "ret.cpp (1)", "car.cpp (1)"] {
+        assert!(r.contains(f), "missing {f}: {e}");
+    }
+    assert!(!r.contains("pp.cpp") && !r.contains("sp.cpp"), "{e}");
+    assert!(certain_calls(&e) >= 5, "{e}");
+    let pu = fox_code(&p, "Pump.start", "callers", 4000);
+    let r = resolved(&pu);
+    for f in ["pp.cpp (2)", "rig.cpp (1)", "auto.cpp (1)", "ret.cpp (1)", "car.cpp (1)", "sp.cpp (1)"] {
+        assert!(r.contains(f), "missing {f}: {pu}");
+    }
+    assert!(!r.contains("local.cpp") && !r.contains("unk.cpp"), "{pu}");
+    // Every call there is certain, except any untyped receiver's (none reaches Pump here).
+    assert!(!resolved(&pu).contains("guess"), "{pu}");
+    assert_eq!(certain_calls(&pu), 7, "{pu}");
+    let s = fox_code(&p, "Engine.stop", "callers", 4000);
+    assert!(resolved(&s).contains("sp.cpp (1)") && !s.contains("guess"), "{s}");
+}
