+/// class loses the `this` path and keeps a name as one of unknown type (`V:name`).
+fn cpp_fix_bases(p: &mut Parsed) {
+    for i in 0..p.refs.len() {
+        let Some(t) = p.refs[i].rtype.clone() else { continue };
