+/// C++ smart pointers and wrappers a call through `->` reaches the pointee of.
+const CPP_POINTERS: &[&str] = &["unique_ptr", "shared_ptr", "optional", "scoped_refptr", "intrusive_ptr"];
+/// C++ functions returning a pointer to the type named by their template argument.
+const CPP_MAKERS: &[&str] =
+    &["make_unique", "make_shared", "make_optional", "static_cast", "dynamic_cast", "reinterpret_cast", "const_cast"];
+
+/// C++: the class a type node names, without namespaces, qualifiers, pointers or references;
+/// a smart pointer names its pointee (`std::unique_ptr<Pump>` -> `Pump`).
+fn cpp_class_name(t: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    let text = |n: tree_sitter::Node| n.utf8_text(src).ok().filter(|s| !s.is_empty() && s.len() <= 120).map(str::to_string);
+    match t.kind() {
+        "type_identifier" => text(t),
+        "qualified_identifier" => cpp_class_name(t.child_by_field_name("name")?, src),
+        "struct_specifier" | "class_specifier" | "union_specifier" => text(t.child_by_field_name("name")?),
+        "template_type" => {
+            let name = cpp_class_name(t.child_by_field_name("name")?, src)?;
+            if !CPP_POINTERS.contains(&name.as_str()) {
+                return Some(name);
+            }
+            let arg = t.child_by_field_name("arguments")?.named_child(0).filter(|a| a.kind() == "type_descriptor")?;
+            cpp_class_name(arg.child_by_field_name("type")?, src)
+        }
+        _ => None,
+    }
+}
+
+/// C++: the type a declaration (or a type descriptor) names, as `S:Engine`. None for a primitive
+/// or `auto`.
+fn cpp_type_name(decl: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    cpp_class_name(decl.child_by_field_name("type")?, src).map(|n| format!("S:{n}"))
+}
+
+/// C++: the type of a value expression that names it: `new Pump()`, `Pump{}`, `(Pump*)p`,
+/// `std::make_unique<Pump>()`, `static_cast<Pump*>(p)` are `S:Pump`; a call `Engine()` or `make()`
+/// is `K:Engine` / `K:make`, a constructor or a function's return type (told apart by the
+/// definitions). None for anything else.
+fn cpp_value_type(v: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    match v.kind() {
+        "new_expression" | "compound_literal_expression" | "cast_expression" => cpp_type_name(v, src),
+        "parenthesized_expression" => cpp_value_type(v.named_child(0)?, src),
+        "call_expression" => {
+            let mut f = v.child_by_field_name("function")?;
+            if f.kind() == "qualified_identifier" {
+                f = f.child_by_field_name("name")?;
+            }
+            match f.kind() {
+                "identifier" => f.utf8_text(src).ok().filter(|t| t.len() <= 120).map(|t| format!("K:{t}")),
+                "template_function" => {
+                    let name = f.child_by_field_name("name")?.utf8_text(src).ok()?;
+                    if !CPP_MAKERS.contains(&name) {
+                        return None;
+                    }
+                    let arg = f.child_by_field_name("arguments")?.named_child(0).filter(|a| a.kind() == "type_descriptor")?;
+                    cpp_type_name(arg, src)
+                }
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+/// The type a declaration names (see [`c_type_name`], [`cpp_type_name`]). C++ `auto` takes the
+/// type of its initializer (`value`, when the declaration has one).
+fn decl_type(decl: tree_sitter::Node, value: Option<tree_sitter::Node>, src: &[u8], cpp: bool) -> Option<String> {
+    if !cpp {
+        return c_type_name(decl, src);
+    }
+    match decl.child_by_field_name("type")?.kind() {
+        "placeholder_type_specifier" => cpp_value_type(value?, src),
+        _ => cpp_type_name(decl, src),
+    }
+}
+
+/// C++: a receiver expression as a type path (see [`c_chain`]), its base `S:Class` (a declared or
+/// inferred type), `K:name` (a call's result) or `M:Class` (a member of the enclosing class,
+/// through an implicit or explicit `this`). None when nothing is known of the base.
+fn cpp_chain(e: tree_sitter::Node, walk: &Walk, src: &[u8], depth: usize) -> Option<String> {
+    if depth > C_CHAIN_MAX {
+        return None;
+    }
+    match e.kind() {
+        "identifier" => walk.recv_types.get(&e.start_byte()).cloned().or_else(|| {
+            let c = walk.implicit.get(&e.start_byte())?;
+            Some(format!("M:{c}|{}", e.utf8_text(src).ok().filter(|t| t.len() <= 120)?))
+        }),
+        "this" => walk.implicit.get(&e.start_byte()).map(|c| format!("M:{c}")),
+        "field_expression" => {
+            let base = cpp_chain(e.child_by_field_name("argument")?, walk, src, depth + 1)?;
+            let f = e.child_by_field_name("field")?.utf8_text(src).ok().filter(|t| !t.is_empty() && t.len() <= 120)?;
+            Some(format!("{base}|{f}"))
+        }
+        "parenthesized_expression" => cpp_chain(e.named_child(0)?, walk, src, depth + 1),
+        "pointer_expression" | "subscript_expression" => cpp_chain(e.child_by_field_name("argument")?, walk, src, depth + 1),
+        _ => cpp_value_type(e, src),
+    }
+}
+
+/// C++: the class a function definition belongs to when it is written outside its class
+/// (`void Engine::start()`, `void ns::Engine::start()`).
+fn cpp_def_class(f: tree_sitter::Node, src: &[u8]) -> Option<String> {
+    let mut d = f.child_by_field_name("declarator")?;
+    while matches!(d.kind(), "pointer_declarator" | "reference_declarator") {
+        d = d.child_by_field_name("declarator").or_else(|| d.named_child(d.named_child_count().checked_sub(1)? as u32))?;
+    }
+    let mut q = d.child_by_field_name("declarator").filter(|q| q.kind() == "qualified_identifier")?;
+    let mut scope = q.child_by_field_name("scope")?;
+    while let Some(n) = q.child_by_field_name("name").filter(|n| n.kind() == "qualified_identifier") {
+        q = n;
+        scope = q.child_by_field_name("scope")?;
+    }
+    if scope.kind() == "template_type" {
+        scope = scope.child_by_field_name("name")?;
+    }
+    scope
+        .utf8_text(src)
+        .ok()
+        .filter(|t| !t.is_empty() && t.len() <= 120 && t.chars().all(|c| c.is_alphanumeric() || c == '_'))
+        .map(str::to_string)
+}
