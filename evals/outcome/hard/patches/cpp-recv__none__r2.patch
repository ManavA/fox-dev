+/// A C++ call through a receiver of known type (a local, a parameter, a member of a typed
+/// struct, `auto` from a constructor, `make_unique` or `new`) reaches that class's method with
+/// certainty, whichever other classes have a method of that name; an unknown receiver stays a
+/// guess.
+#[test]
+fn cpp_member_calls_resolve_through_the_receivers_type() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    for split in [false, true] {
+        let (_h, _r, p) = cpp_recv_project(split);
+        for (sym, lines, sites) in [
+            ("Engine.start", vec![":5 local", ":13 members", ":19 autos"], 5),
+            ("Pump.start", vec![":8,9 params", ":14 members", ":21,23 autos"], 5),
+            ("Boat.start", vec![":10 params", ":15 members"], 2),
+        ] {
+            let out = fox_code(&p, sym, "callers", 4000);
+            let r = resolved(&out);
+            for l in &lines {
+                assert!(r.contains(l), "split {split} {sym}: missing {l}: {out}");
+            }
+            assert!(r.contains(&format!("{sites} call sites in 1 files")), "split {split} {sym}: {out}");
+            // Only Engine takes the two receivers of unknown type, as guesses.
+            let guesses = r.matches("guess 1 of").count();
+            assert_eq!(guesses, if sym == "Engine.start" { 2 } else { 0 }, "split {split} {sym}: {out}");
+            assert!(r.contains(":26 unknown") == (sym == "Engine.start"), "split {split} {sym}: {out}");
+        }
+    }
+}
