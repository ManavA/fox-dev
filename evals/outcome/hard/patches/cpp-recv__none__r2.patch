+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = inline_project(&[
+        (
+            "t.hpp",
+            "class Engine {\npublic:\n  void go() {}\n};\nclass Pump {\npublic:\n  void go() {}\n};\nstruct Rig {\n  Engine part;\n};\n",
+        ),
+        ("use.cpp", "#include \"t.hpp\"\nvoid use(Rig& r) {\n  r.part.go();\n}\nvoid other() {\n  Gear g;\n  g.go();\n}\n"),
+    ]);
+    let first = fox_code(&p, "Engine.go", "callers", 4000);
+    assert!(resolved(&first).contains(":3 use") && first.contains("guess 1 of 2"), "{first}");
+    let mut c = db::open_rw().unwrap();
+    let h = repo.path().join("t.hpp");
+    let text = std::fs::read_to_string(&h).unwrap();
+    std::fs::write(&h, text.replace("Engine part;", "Pump part;")).unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    assert_eq!(tsindex::index_project(&mut c, &p).unwrap().parsed, 1);
+    let engine = fox_code(&p, "Engine.go", "callers", 4000);
+    let pump = fox_code(&p, "Pump.go", "callers", 4000);
+    assert!(!resolved(&engine).contains(":3 use") && resolved(&pump).contains(":3 use"), "{engine}\n{pump}");
+    // A class appearing makes `Gear g; g.go()` typed: it is Gear's, no longer a guess.
+    let text = std::fs::read_to_string(&h).unwrap();
