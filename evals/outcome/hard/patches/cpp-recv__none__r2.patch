+fn cpp_recv_project(split: bool) -> (tempfile::TempDir, tempfile::TempDir, project::Project) {
+    let head_inline = "#pragma once\nclass Engine {\npublic:\n  void start() {}\n  void stop() {}\n};\nclass Pump {\npublic:\n  void start() {}\n};\nclass Boat {\npublic:\n  void start() {}\n};\nstruct Rig {\n  Engine engine;\n  Pump* pump;\n  std::unique_ptr<Boat> boat;\n};\n";
