+fn c_typedef_ops_project() -> (tempfile::TempDir, tempfile::TempDir, project::Project) {
+    inline_project(&[
+        ("types.h", "typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int myint;\n"),
+        ("ops.h", "#include \"types.h\"\nstruct ops {\n\top_fn run;\n\top2_fn run2;\n\tmyint count;\n\top_fn *table;\n};\n"),
+        (
+            "impl.c",
+            "#include \"ops.h\"\nstatic int impl(int x) { return x; }\nstatic int impl2(int x) { return x; }\nstruct ops o = {\n\t.run = impl,\n\t.run2 = impl2,\n};\n",
+        ),
+        (
+            "call.c",
+            "#include \"ops.h\"\nint use(struct ops *o, int x) { return o->run(x); }\nint use2(struct ops *o, int x) { return o->run2(x); }\nint count(int x) { return x; }\nint use3(struct ops *o) { return count(o->count); }\n",
+        ),
+    ])
+}
+
+/// A member whose type is a typedef of a function pointer (`op_fn run;`, also a typedef of a
+/// typedef) behaves like `int (*run)(int)`: calls through it, functions stored in it and impact
+/// reach it; a plain data member of a typedef type (`myint count;`) stays a field.
+#[test]
+fn c_typedef_function_pointer_members_behave_like_plain_ones() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = c_typedef_ops_project();
+    let r = resolved(&fox_code(&p, "ops.run", "callers", 4000));
+    assert!(r.contains("call.c (1)") && r.contains("1 call sites in 1 files"), "{r}");
+    let out = fox_code(&p, "ops.run", "callers", 4000);
+    assert!(out.lines().next().unwrap_or("").contains("1 line stores a function in it (not a call)"), "{out}");
+    let r2 = resolved(&fox_code(&p, "ops.run2", "callers", 4000));
+    assert!(r2.contains("call.c (1)") && r2.contains("1 call sites in 1 files"), "{r2}");
+    let out = fox_code(&p, "impl", "impact", 4000);
+    assert!(out.contains("use c:") && out.contains("via ops.run"), "{out}");
+    let out = fox_code(&p, "impl2", "impact", 4000);
+    assert!(out.contains("use2 c:") && out.contains("via ops.run2"), "{out}");
+    let out = fox_code(&p, "ops.run", "impact", 4000);
+    assert!(out.contains("impl c:") && out.contains("implements ops.run"), "{out}");
+    // Data members stay fields: no function member, and the global `count` keeps its caller.
+    let c = db::open_ro().unwrap();
+    let kind = |n: &str| -> String {
+        c.query_row(
+            "SELECT json_extract(meta,'$.k') FROM node WHERE project_id = ?1 AND name = ?2 AND kind = 'symbol' AND path = 'ops.h'",
+            rusqlite::params![p.id, n],
+            |r| r.get(0),
+        )
+        .unwrap()
+    };
+    assert_eq!(kind("count"), "field");
+    assert_eq!(kind("table"), "field");
+    assert_eq!(kind("run"), "method");
+    assert_eq!(kind("run2"), "method");
+    let g = resolved(&fox_code(&p, &c_sym(&p, "call.c", "count"), "callers", 4000));
+    assert!(g.contains("use3") || g.contains("call.c (1)"), "{g}");
+}
+
+/// Editing the typedef moves the members: dropping its function-pointer shape turns the members
+/// back into fields, and the incremental update matches a full re-resolution.
+#[test]
+fn c_typedef_function_pointer_edits_reclassify_members() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, repo, p) = c_typedef_ops_project();
+    let mut c = db::open_rw().unwrap();
+    let t = repo.path().join("types.h");
+    std::fs::write(&t, "typedef int op_fn;\ntypedef op_fn op2_fn;\ntypedef int myint;\n").unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    let out = fox_code(&p, "ops.run", "callers", 4000);
+    assert!(!resolved(&out).contains("call.c"), "{out}");
+    std::fs::write(&t, "typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int myint;\n").unwrap();
+    inventory::index_project(&mut c, &p).unwrap();
+    tsindex::index_project(&mut c, &p).unwrap();
+    let out = fox_code(&p, "ops.run2", "callers", 4000);
+    assert!(resolved(&out).contains("call.c (1)"), "{out}");
+    let snap = |c: &rusqlite::Connection| -> Vec<(i64, i64, i64)> {
+        let mut q = c.prepare("SELECT rowid, dst, slot FROM ts_ref ORDER BY rowid").unwrap();
+        q.query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).unwrap().flatten().collect()
+    };
+    let inc = snap(&c);
+    tsindex::resolve(&c, p.id).unwrap();
+    assert_eq!(snap(&c), inc);
+}
