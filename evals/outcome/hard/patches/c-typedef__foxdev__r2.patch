+/// Is typedef `name` a function pointer: declared as one, or a typedef of such a typedef? Every
+/// definition of the name must be (two that differ leave it unknown, so no). `memo` holds the
+/// answers; `depth` bounds the typedef chain.
+fn c_fn_typedef(tx: &Connection, pid: i64, name: &str, memo: &mut HashMap<String, bool>, depth: usize) -> Result<bool> {
+    if let Some(&b) = memo.get(name) {
+        return Ok(b);
+    }
+    if depth > C_ALIAS_STEPS {
+        return Ok(false);
+    }
+    // A cycle answers no while it is read.
+    memo.insert(name.to_string(), false);
+    let mut q = tx.prepare_cached(
+        "SELECT name, lang, json_extract(meta,'$.k'), json_extract(meta,'$.fp'), COALESCE(json_extract(meta,'$.t'),'')
+         FROM node WHERE project_id = ?1 AND kind = 'symbol' AND name = ?2 COLLATE NOCASE AND source = 'treesitter'",
+    )?;
+    type Row = (String, String, Option<String>, Option<i64>, String);
+    let rows: Vec<Row> = q
+        .query_map(params![pid, name], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?, r.get(4)?)))?
+        .flatten()
+        .filter(|x: &Row| x.0 == name && x.2.as_deref() == Some("type") && lang::by_name(&x.1).is_some_and(|l| l.family == "c"))
+        .collect();
+    drop(q);
+    let mut all = !rows.is_empty();
+    for (_, _, _, fp, t) in &rows {
+        all &= fp.is_some()
+            || match t.strip_prefix("T:") {
+                Some(n) => c_fn_typedef(tx, pid, n, memo, depth + 1)?,
+                None => false,
+            };
+    }
+    memo.insert(name.to_string(), all);
+    Ok(all)
+}
+
+/// C: a member typed by a typedef (`op_fn run;`, the type declared in another file) is a function
+/// member when the typedef names a function pointer, a field otherwise: set its kind and
+/// function flag from that, so calls through it, functions stored in it and impact treat it like
+/// `int (*run)(int)`. Members of `paths` only, or of the whole project when `paths` is None.
+fn reclassify_fn_members(tx: &Connection, pid: i64, paths: Option<&HashSet<String>>) -> Result<()> {
+    let cols = "SELECT id, json_extract(meta,'$.t'), json_extract(meta,'$.f') IS NOT NULL FROM node
+         WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter' AND json_extract(meta,'$.fv') = 1";
+    let row = |r: &rusqlite::Row| Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?, r.get::<_, bool>(2)?));
+    let mut members: Vec<(i64, String, bool)> = vec![];
+    match paths {
+        None => {
+            let mut q = tx.prepare_cached(cols)?;
+            members.extend(q.query_map([pid], row)?.flatten());
+        }
+        Some(paths) => {
+            let mut q = tx.prepare_cached(&format!("{cols} AND path = ?2"))?;
+            for path in paths {
+                members.extend(q.query_map(params![pid, path], row)?.flatten());
+            }
+        }
+    }
+    let mut memo: HashMap<String, bool> = HashMap::new();
+    let mut set = tx.prepare_cached("UPDATE node SET meta = json_set(meta, '$.k', 'method', '$.f', 1) WHERE id = ?1")?;
+    let mut unset = tx.prepare_cached("UPDATE node SET meta = json_set(json_remove(meta, '$.f'), '$.k', 'field') WHERE id = ?1")?;
+    for (id, t, was) in members {
+        let want = match t.strip_prefix("T:") {
+            Some(n) => c_fn_typedef(tx, pid, n, &mut memo, 0)?,
+            None => false,
+        };
+        if want != was {
+            if want {
+                set.execute([id])?
+            } else {
+                unset.execute([id])?
+            };
+        }
+    }
+    Ok(())
+}
