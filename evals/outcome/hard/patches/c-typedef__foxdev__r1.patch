+/// Most typedef steps followed from a member's type to a function-pointer typedef.
+const FN_TYPEDEF_STEPS: usize = 8;
+
+/// A typedef definition: whether it is a function pointer, and the type it names.
+type TypedefRow = (bool, Option<String>);
+
+/// C: is typedef `name` a function pointer, directly (`typedef int (*op_fn)(int);`) or through
+/// typedefs of it (`typedef op_fn op2_fn;`)? Two definitions of a name that disagree, or a chain
+/// that ends in anything else, say no.
+fn is_fn_typedef(name: &str, tdef: &mut dyn FnMut(&str) -> Vec<TypedefRow>) -> bool {
+    let mut cur = name.to_string();
+    let mut seen: Vec<String> = vec![];
+    for _ in 0..FN_TYPEDEF_STEPS {
+        if seen.contains(&cur) {
+            return false;
+        }
+        let defs = tdef(&cur);
+        seen.push(cur);
+        if defs.is_empty() {
+            return false;
+        }
+        if defs.iter().all(|d| d.0) {
+            return true;
+        }
+        let mut next = defs.iter().map(|d| d.1.as_deref().and_then(|t| t.strip_prefix("T:")));
+        match next.next() {
+            Some(Some(n)) if !defs.iter().any(|d| d.0) && next.all(|x| x == Some(n)) => cur = n.to_string(),
+            _ => return false,
+        }
+    }
+    false
+}
+
+/// C: a plain member declared with a typedef type (`op_fn run;`) is a function-pointer member
+/// when that typedef names a function pointer, here or in another file, and a data member
+/// otherwise; the member's `method`/`field` kind follows. Members in `paths` are settled (all
+/// of them when `paths` is None or `all`: a typedef changed). Returns the names of the members
+/// whose kind changed, so their references re-score.
+fn settle_fn_typedefs(tx: &Connection, pid: i64, paths: Option<&HashSet<String>>, all: bool) -> Result<HashSet<String>> {
+    let mut changed: HashSet<String> = HashSet::new();
+    let sel = "SELECT id, name, json_extract(meta,'$.t'), json_extract(meta,'$.ft') FROM node \
+               WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter' AND json_extract(meta,'$.tf') = 1";
+    let mut members: Vec<(i64, String, String, bool)> = vec![];
+    let row = |r: &rusqlite::Row| {
+        Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?, r.get::<_, String>(2)?, r.get::<_, Option<i64>>(3)?.is_some()))
+    };
+    match paths.filter(|_| !all) {
+        None => {
+            let mut q = tx.prepare_cached(sel)?;
+            members.extend(q.query_map([pid], row)?.flatten());
+        }
+        Some(paths) => {
+            let mut q = tx.prepare_cached(&format!("{sel} AND path = ?2"))?;
+            for path in paths {
+                members.extend(q.query_map(params![pid, path], row)?.flatten());
+            }
+        }
+    }
+    if members.is_empty() {
+        return Ok(changed);
+    }
+    let mut q = tx.prepare_cached(
+        "SELECT json_extract(meta,'$.fp'), json_extract(meta,'$.t') FROM node
+         WHERE project_id = ?1 AND kind = 'symbol' AND source = 'treesitter' AND lang = 'c' AND name = ?2 AND json_extract(meta,'$.k') = 'type'",
+    )?;
+    let mut memo: HashMap<String, bool> = HashMap::new();
+    let mut make = tx.prepare_cached("UPDATE node SET meta = json_set(meta, '$.k', 'method', '$.f', 1, '$.ft', 1) WHERE id = ?1")?;
+    let mut unmake =
+        tx.prepare_cached("UPDATE node SET meta = json_set(json_remove(meta, '$.f', '$.ft'), '$.k', 'field') WHERE id = ?1")?;
+    for (id, name, t, was) in members {
+        let Some(ty) = t.strip_prefix("T:") else { continue };
+        let is = match memo.get(ty) {
+            Some(&b) => b,
+            None => {
+                let b = is_fn_typedef(ty, &mut |n| {
+                    q.query_map(params![pid, n], |r| Ok((r.get::<_, Option<i64>>(0)?.is_some(), r.get::<_, Option<String>>(1)?)))
+                        .map(|it| it.flatten().collect())
+                        .unwrap_or_default()
+                });
+                memo.insert(ty.to_string(), b);
+                b
+            }
+        };
+        if is != was {
+            if is {
+                make.execute([id])?
+            } else {
+                unmake.execute([id])?
+            };
+            changed.insert(name);
+        }
+    }
+    Ok(changed)
+}
