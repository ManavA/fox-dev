+/// A function-pointer member whose type is a typedef (also a typedef of a typedef, and one
+/// declared in another file than the struct) behaves like a plain `int (*run)(int)` member: calls
+/// through it reach it, a function stored in it is a store, and impact of the function reaches
+/// the callers of the member. A plain data field with a typedef type is no function member.
+#[test]
+fn c_typedef_function_pointer_members_behave_like_plain_ones() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, _r, p) = inline_project(&[
+        ("include/types.h", "typedef int (*op_fn)(int);\ntypedef op_fn op2_fn;\ntypedef int count_t;\ntypedef char *(*mk_fn)(int);\n"),
+        (
+            "include/ops.h",
+            "#include \"types.h\"\nstruct plain { int (*run)(int); };\nstruct ops { op_fn run; op2_fn run2; count_t n; mk_fn mk; op_fn *many; };\n",
+        ),
+        (
+            "core/call.c",
+            "#include \"ops.h\"\nint dispatch(struct ops *o, int x) { return o->run(x); }\nint dispatch2(struct ops *o, int x) { return o->run2(x); }\nint plain_go(struct plain *o, int x) { return o->run(x); }\nchar *build(struct ops *o) { return o->mk(1); }\n",
+        ),
+        (
+            "drv/a.c",
+            "#include \"ops.h\"\nstatic int impl(int x) { return x; }\nstatic int impl2(int x) { return x; }\nstatic int pimpl(int x) { return x; }\nstatic char *mkimpl(int x) { return 0; }\nstatic struct ops a_ops = { .run = impl, .run2 = impl2, .mk = mkimpl };\nstatic struct plain a_plain = { .run = pimpl };\n",
+        ),
+    ]);
+    let out = fox_code(&p, "ops.run", "callers", 4000);
+    assert!(out.contains("1 call sites in 1 files") && out.contains("dispatch"), "{out}");
+    assert!(out.contains("| .run = impl,") || out.contains(".run = impl"), "{out}");
+    let out = fox_code(&p, "ops.run2", "callers", 4000);
+    assert!(out.contains("1 call sites in 1 files") && out.contains("dispatch2"), "{out}");
+    let out = fox_code(&p, "ops.mk", "callers", 4000);
+    assert!(out.contains("1 call sites in 1 files") && out.contains("build"), "{out}");
+    for (f, caller) in [("impl", "dispatch"), ("impl2", "dispatch2"), ("pimpl", "plain_go"), ("mkimpl", "build")] {
+        let out = fox_code(&p, f, "impact", 4000);
+        assert!(out.contains(caller), "impact of {f} misses {caller}: {out}");
+    }
+    // Data fields stay fields: not methods, and no call reaches them.
+    let kinds: Vec<(String, String)> = {
+        let c = db::open_rw().unwrap();
+        let mut q = c
+            .prepare("SELECT name, json_extract(meta,'$.k') FROM node WHERE project_id = ?1 AND path = 'include/ops.h' AND name IN ('n','many','run','run2','mk') ORDER BY name")
+            .unwrap();
+        q.query_map([p.id], |r| Ok((r.get(0)?, r.get(1)?))).unwrap().flatten().collect()
+    };
+    let want = [("many", "field"), ("mk", "method"), ("n", "field"), ("run", "method"), ("run2", "method"), ("run", "method")];
+    for (n, k) in want {
+        assert!(kinds.iter().any(|x| x.0 == n && x.1 == k), "{n} should be {k}: {kinds:?}");
+    }
+}
+
+/// Editing the typedef in a header turns the members declared with it into data members, and
+/// back, on an incremental run.
+#[test]
+fn c_typedef_edit_flips_members_incrementally() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let (_h, r, p) = inline_project(&[
+        ("include/types.h", "typedef int (*op_fn)(int);\n"),
+        ("include/ops.h", "#include \"types.h\"\nstruct ops { op_fn run; };\n"),
+        ("core/call.c", "#include \"ops.h\"\nint dispatch(struct ops *o, int x) { return o->run(x); }\n"),
+    ]);
+    let kind = || -> String {
+        let c = db::open_rw().unwrap();
+        c.query_row(
+            "SELECT json_extract(meta,'$.k') FROM node WHERE project_id = ?1 AND name = 'run' AND path = 'include/ops.h'",
+            [p.id],
+            |r| r.get(0),
+        )
+        .unwrap()
+    };
+    let reindex = |types: &str| {
+        std::fs::write(r.path().join("include/types.h"), types).unwrap();
+        let mut c = db::open_rw().unwrap();
+        inventory::index_project(&mut c, &p).unwrap();
+        tsindex::index_project(&mut c, &p).unwrap();
+    };
+    assert_eq!(kind(), "method");
+    assert!(fox_code(&p, "ops.run", "callers", 4000).contains("1 call sites in 1 files"));
+    reindex("typedef int op_fn;\n");
+    assert_eq!(kind(), "field");
+    assert!(!fox_code(&p, "ops.run", "callers", 4000).contains("1 call sites"));
+    reindex("typedef int (*op_fn)(int);\n");
+    assert_eq!(kind(), "method");
+    assert!(fox_code(&p, "ops.run", "callers", 4000).contains("1 call sites in 1 files"));
+}
